diff --git a/CMakeLists.txt b/CMakeLists.txt
index 02c889f..a83f99c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -139,7 +139,18 @@ set(FILAMENT_OSMESA_PATH "" CACHE STRING
 set(SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS OFF)
 
 if (NOT FILAMENT_ENABLE_EXCEPTIONS)
-    add_compile_options(-fno-exceptions)
+    # SDL is only needed by the desktop tools and their tests.
+    set(FILAMENT_SKIP_SDL2 ON)
+    if (MSVC)
+        string(REPLACE "/EHsc" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+        add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:/EHs-c->")
+        add_compile_definitions(_HAS_EXCEPTIONS=0)
+    else()
+        add_compile_options("$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:-fno-exceptions>")
+        # Clang still defines __EXCEPTIONS for Objective-C exceptions. Keep
+        # C++ headers (including Panic's layout) consistent with C++ sources.
+        add_compile_options("$<$<COMPILE_LANGUAGE:OBJCXX>:-U__EXCEPTIONS>")
+    endif()
     set(SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS ON)
 endif()
 
@@ -213,6 +224,11 @@ if (NOT FILAMENT_OSMESA_PATH STREQUAL "")
     set(FILAMENT_SUPPORTS_OSMESA TRUE CACHE BOOL "Enable OSMesa (headless GL context) for Filament" FORCE)
 endif()
 
+if (LINUX AND NOT FILAMENT_ENABLE_EXCEPTIONS)
+    # Thermion's Linux runtime is headless: never create an X11 surface.
+    set(DAWN_USE_X11 OFF)
+endif()
+
 if (LINUX)
     if (FILAMENT_SUPPORTS_WAYLAND)
         add_definitions(-DFILAMENT_SUPPORTS_WAYLAND)
@@ -997,14 +1013,14 @@ add_subdirectory(${FILAMENT}/filament)
 set(FILAMENT_SAMPLES_BINARY_DIR ${PROJECT_BINARY_DIR}/samples)
 
 # assimp is only used by filamentapp's MeshAssimp, which is not built for WASM.
-if (IS_HOST_PLATFORM OR ANDROID)
-   add_subdirectory(${EXTERNAL}/libassimp/tnt)
+if ((IS_HOST_PLATFORM OR ANDROID) AND FILAMENT_ENABLE_EXCEPTIONS)
+    add_subdirectory(${EXTERNAL}/libassimp/tnt)
 endif()
 
 # filamentapp must come before the web/ subdirectories so that its target is
 # already defined when the WASM samples link against it.
-if (IS_HOST_PLATFORM OR ANDROID OR WASM)
-   add_subdirectory(${LIBRARIES}/filamentapp)
+if ((IS_HOST_PLATFORM OR ANDROID OR WASM) AND FILAMENT_ENABLE_EXCEPTIONS)
+    add_subdirectory(${LIBRARIES}/filamentapp)
 endif()
 
 if (WASM)
@@ -1013,22 +1029,26 @@ if (WASM)
     # Excluded from the default build so that building filament.js does not also build the
     # samples, their resources, and the IBL cmgen produces for them. Build the samples through
     # the filament-samples target, or name one, e.g. gltf_viewer.
-    add_subdirectory(${FILAMENT}/samples EXCLUDE_FROM_ALL)
+    if (FILAMENT_ENABLE_EXCEPTIONS)
+        add_subdirectory(${FILAMENT}/samples EXCLUDE_FROM_ALL)
+    endif()
 endif()
 
 if (IS_HOST_PLATFORM)
     if (FILAMENT_SUPPORTS_OPENGL)
         add_subdirectory(${LIBRARIES}/bluegl)
     endif()
+endif()
+
+# Desktop tools have their own host build. Runtime builds import those tools
+# so their image encoders and command-line parsers do not enter this build.
+if (IS_HOST_PLATFORM AND FILAMENT_ENABLE_EXCEPTIONS)
     add_subdirectory(${LIBRARIES}/imageio)
     add_subdirectory(${LIBRARIES}/filament-matp)
 
     add_subdirectory(${FILAMENT}/samples)
 
-    add_subdirectory(${EXTERNAL}/libpng/tnt)
     add_subdirectory(${EXTERNAL}/libsdl2/tnt)
-    add_subdirectory(${EXTERNAL}/libz/tnt)
-    add_subdirectory(${EXTERNAL}/tinyexr/tnt)
 
     add_subdirectory(${TOOLS}/cmgen)
     add_subdirectory(${TOOLS}/cso-lut)
@@ -1050,6 +1070,12 @@ if (IS_HOST_PLATFORM)
     add_subdirectory(${TOOLS}/specgen)
 endif()
 
+if (IS_HOST_PLATFORM)
+    add_subdirectory(${EXTERNAL}/libpng/tnt)
+    add_subdirectory(${EXTERNAL}/libz/tnt)
+    add_subdirectory(${EXTERNAL}/tinyexr/tnt)
+endif()
+
 # Generate exported executables for cross-compiled builds (Android, WASM, and iOS)
 if ((NOT CMAKE_CROSSCOMPILING AND NOT FILAMENT_IMPORT_PREBUILT_EXECUTABLES) OR FILAMENT_EXPORT_PREBUILT_EXECUTABLES)
     export(TARGETS matc cmgen filamesh mipgen resgen uberz glslminifier FILE ${IMPORT_EXECUTABLES})
diff --git a/build.sh b/build.sh
index 05a2c8d..074e794 100755
--- a/build.sh
+++ b/build.sh
@@ -286,6 +286,7 @@ function build_tools_for_split_build {
         ${WEBGPU_OPTION} \
         ${architectures} \
         -DFILAMENT_ENABLE_EXCEPTIONS=ON \
+        ${FILAMENT_HOST_TOOLS_OPTIONS:-} \
         ${MUTEX_DEBUG_OPTION} \
         ../..
 
@@ -594,7 +595,9 @@ function build_android {
     local old_install_command=${INSTALL_COMMAND}
     INSTALL_COMMAND=
 
-    build_desktop "${MOBILE_HOST_TOOLS}"
+    if [[ "${ISSUE_SPLIT_BUILD}" != "true" ]]; then
+        build_desktop "${MOBILE_HOST_TOOLS}"
+    fi
 
     # When building the samples, we need to partially "install" the host tools so Gradle can see
     # them.
@@ -637,6 +640,11 @@ function build_android {
         archive_android "Release"
     fi
 
+    # Thermion uses the native archives, not Filament's JNI/AAR libraries.
+    if [[ "${EXCEPTIONS_OPTION}" == "-DFILAMENT_ENABLE_EXCEPTIONS=OFF" ]]; then
+        return
+    fi
+
     local root_dir=$(pwd)
 
     pushd android > /dev/null
@@ -816,7 +824,9 @@ function build_ios {
     local old_install_command=${INSTALL_COMMAND}
     INSTALL_COMMAND=
 
-    build_desktop "${MOBILE_HOST_TOOLS}"
+    if [[ "${ISSUE_SPLIT_BUILD}" != "true" ]]; then
+        build_desktop "${MOBILE_HOST_TOOLS}"
+    fi
 
     INSTALL_COMMAND=${old_install_command}
 
