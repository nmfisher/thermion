+# matp (the material parser behind matc) is exception-free and is built for
+# every runtime that compiles materials on device: Android, iOS, WASM, and
+# desktop. iOS compiles without exceptions, which matp satisfies.
+if (IS_HOST_PLATFORM OR ANDROID OR IOS OR WASM)
+    add_subdirectory(${LIBRARIES}/filamat-matp)
+endif()
+
 if (IS_HOST_PLATFORM)
     if (FILAMENT_SUPPORTS_OPENGL)
         add_subdirectory(${LIBRARIES}/bluegl)
@@ -1029,7 +1036,6 @@ endif()
 # so their image encoders and command-line parsers do not enter this build.
 if (IS_HOST_PLATFORM AND FILAMENT_ENABLE_EXCEPTIONS)
     add_subdirectory(${LIBRARIES}/imageio)
-    add_subdirectory(${LIBRARIES}/filament-matp)
 
     add_subdirectory(${FILAMENT}/samples)
 
