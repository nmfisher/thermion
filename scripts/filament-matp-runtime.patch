diff --git a/CMakeLists.txt b/CMakeLists.txt
index a83f99c..0171534 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1040,11 +1040,16 @@ if (IS_HOST_PLATFORM)
     endif()
 endif()
 
+# matp (the material parser behind matc) is exception-free and is also built
+# for the Android and WASM runtimes, which compile materials on device.
+if (IS_HOST_PLATFORM OR ANDROID OR WASM)
+    add_subdirectory(${LIBRARIES}/filament-matp)
+endif()
+
 # Desktop tools have their own host build. Runtime builds import those tools
 # so their image encoders and command-line parsers do not enter this build.
 if (IS_HOST_PLATFORM AND FILAMENT_ENABLE_EXCEPTIONS)
     add_subdirectory(${LIBRARIES}/imageio)
-    add_subdirectory(${LIBRARIES}/filament-matp)
 
     add_subdirectory(${FILAMENT}/samples)
 
