material {
    name : SssBlur,
    parameters : [
        {
            type : sampler2d,
            name : color,
            precision : high
        },
        {
            type : sampler2d,
            format : float,
            name : depth,
            precision : high
        },
        {
            type : sampler2d,
            name : mask,
            precision : medium
        },
        {
            type : float2,
            name : direction
        },
        {
            type : float2,
            name : texelSize
        },
        {
            type : float3,
            name : scatterRadius
        },
        {
            type : float,
            name : depthFalloff
        },
        {
            type : float2,
            name : depthRange
        },
        {
            type : int,
            name : orthographic
        },
        {
            type : int,
            name : useDepth
        },
        {
            type : int,
            name : useMask
        }
    ],
    variables : [
        screenUV
    ],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    vertexDomain : device
}

//
// One direction of the separable, depth-aware, chromatic subsurface blur.
//
// The same material is used for both the horizontal and the vertical pass;
// `direction` selects the axis. All texture parameters are bound by the Dart
// side (see SubsurfaceScatteringPassManager).
//
// Inputs
//   color     The buffer being scattered. Pass A reads the main scene colour
//             (full resolution); pass B reads the output of pass A (reduced
//             resolution).
//   depth     The main view's depth attachment, sampled at full resolution in
//             both passes so that both passes reject across the same
//             discontinuities.
//   mask      Skin coverage, 1 where skin was rendered (full resolution).
// Output
//   The scattered (blurred) radiance for the pass, written to the pass' own
//   render target. The result is NOT a final image; the composite pass mixes
//   it back over the un-scattered scene colour.
//
// Scattering is chromatic: each channel is sampled at its own radius, so red
// spreads further than green and green further than blue. Each tap is also
// weighted by the linear-depth difference between it and the centre pixel so
// colour does not bleed across silhouettes or in from the background.
//

fragment {
    const int kTapCount = 9;

    // Symmetric taps in [-1, 1]; 1.0 is the outermost sample, i.e. the radius.
    const float kTapOffset[9] = float[](
        -1.0, -0.75, -0.5, -0.25, 0.0, 0.25, 0.5, 0.75, 1.0
    );

    // Gaussian weights matching kTapOffset (sums to 1.0 before depth/mask
    // weighting is applied).
    const float kTapWeight[9] = float[](
        0.0162162162, 0.0540540541, 0.1216216216, 0.1945945946, 0.2270270270,
        0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162
    );

    // Convert a [0,1] depth-buffer value to a view-space distance.
    //
    // Filament does not use reversed-Z, and the depth attachment holds 0 at the
    // near plane and 1 at the far plane on every backend, so the perspective
    // form below is backend independent (the OpenGL [-1,1] and the
    // Vulkan/Metal [0,1] NDC conventions both reduce to it).
    //
    // An orthographic projection stores depth linearly, so it needs its own
    // branch.
    float linearizeDepth(float d) {
        float n = materialParams.depthRange.x;
        float f = materialParams.depthRange.y;
        if (materialParams.orthographic == 1) {
            return mix(n, f, d);
        }
        return (n * f) / max(f - d * (f - n), 1e-6);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp vec2 uv = uvToRenderTargetUV(variable_screenUV.st);

        vec2 dir = materialParams.direction * materialParams.texelSize;

        float centerDepth = 0.0;
        if (materialParams.useDepth == 1) {
            centerDepth = linearizeDepth(textureLod(materialParams_depth, uv, 0.0).r);
        }

        vec3 sum = vec3(0.0);
        float weightSum = 0.0;

        for (int i = 0; i < kTapCount; i++) {
            float offset = kTapOffset[i];
            float weight = kTapWeight[i];

            // The depth and mask taps are taken at the largest per-channel
            // radius (red). Sampling them per channel would triple the depth
            // fetches for no visible gain: depth varies smoothly inside an
            // object, and it is exactly the outermost samples that the depth
            // term needs to reject.
            vec2 tapUv = uv + dir * (offset * materialParams.scatterRadius.r);

            float tapMask = 1.0;
            if (materialParams.useMask == 1) {
                tapMask = textureLod(materialParams_mask, tapUv, 0.0).r;
            }

            if (materialParams.useDepth == 1) {
                float tapDepth = linearizeDepth(textureLod(materialParams_depth, tapUv, 0.0).r);
                weight *= exp(-abs(tapDepth - centerDepth) * materialParams.depthFalloff);
            }

            weight *= tapMask;
            if (weight <= 0.0) {
                continue;
            }

            // Chromatic: red scatters furthest, blue least.
            sum.r += textureLod(materialParams_color, uv + dir * (offset * materialParams.scatterRadius.r), 0.0).r * weight;
            sum.g += textureLod(materialParams_color, uv + dir * (offset * materialParams.scatterRadius.g), 0.0).g * weight;
            sum.b += textureLod(materialParams_color, uv + dir * (offset * materialParams.scatterRadius.b), 0.0).b * weight;

            weightSum += weight;
        }

        // Normalise by the weight that actually survived the depth and mask
        // tests rather than by the raw kernel sum. Normalising by the raw sum
        // leaves a dark rim just inside the skin silhouette, where most taps
        // have been rejected.
        vec3 scattered = sum / max(weightSum, 1e-4);

        material.baseColor = vec4(scattered, 1.0);
    }
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Convert from clip space [-1,1] to UV space [0,1]
        material.screenUV.st = getPosition().xy * 0.5 + 0.5;
    }
}
