material {
    name : SssComposite,
    parameters : [
        {
            type : sampler2d,
            name : sceneColor,
            precision : high
        },
        {
            type : sampler2d,
            name : scattered,
            precision : high
        },
        {
            type : sampler2d,
            name : mask,
            precision : medium
        },
        {
            type : float,
            name : intensity
        }
    ],
    variables : [
        screenUV
    ],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    vertexDomain : device
}

//
// Final screen-space subsurface scattering pass.
//
// Mixes the scattered (blurred) radiance produced by the two SssBlur passes
// back over the un-scattered main scene colour, but only where the skin mask
// is set, so the rest of the scene is untouched.
//
// `scattered` is the reduced-resolution vertical blur output; sampling it at
// full resolution with linear filtering is the upsample.
//
// Colour space: every texture in the chain is SRGB8_A8. The GPU linearises on
// sample and re-encodes on write, so the mix below runs in linear space even
// though the buffers are 8-bit. `intensity` is a plain 0..1 lerp factor and is
// not tonemapped.
//
// This is the last pass in the chain and it writes straight into a destination
// Filament does not sRGB-encode for us: post processing is off on this view and
// thermion's swapchain is a linear RGBA8 target, so a linear value written here
// lands in the framebuffer un-encoded and the final image comes out darker than
// the same scene rendered without the effect. The pass therefore applies the
// sRGB transfer function itself. With intensity 0 the output is bit-identical
// to the main view rendered without the effect (verified in
// test/subsurface_scattering_tests.dart).
//
fragment {
    // Exact sRGB electro-optical transfer, not the 2.2 power approximation.
    vec3 linearToSrgb(vec3 c) {
        return mix(c * 12.92, 1.055 * pow(max(c, 0.0), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp vec2 uv = uvToRenderTargetUV(variable_screenUV.st);

        vec4 scene = textureLod(materialParams_sceneColor, uv, 0.0);
        float mask = textureLod(materialParams_mask, uv, 0.0).r;
        vec3 scattered = textureLod(materialParams_scattered, uv, 0.0).rgb;

        float amount = materialParams.intensity * saturate(mask);

        // Alpha is coverage and is not gamma encoded.
        material.baseColor = vec4(linearToSrgb(mix(scene.rgb, scattered, amount)), scene.a);
    }
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Convert from clip space [-1,1] to UV space [0,1]
        material.screenUV.st = getPosition().xy * 0.5 + 0.5;
    }
}
