material {
    name : TranslationAxis,
    parameters : [
        {
            type : float3,
            name : origin,
            precision : high  // Origin in object space (typically 0,0,0 when positioned via transform)
        },
        {
            type : int,
            name : axis
        },
        {
            type : float,
            name : lineWidth,
            default : 5.0
        },
        {
            type : float,
            name : lineLength,
            default : 100.0
        }
    ],
    requires : [uv0],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : true,
    depthCulling : true,
    culling : none,
    instanced : false,
    vertexDomain : object,
    variantFilter : [ dynamicLighting, directionalLighting, shadowReceiver, skinning, ssr, stereo ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Pass the object-space position through UV
        material.uv0 = getPosition().xz;
    }
}

fragment {
    // Antialiasing constants (from grid.mat)
    #define _1_DIV_SQRTPI 0.5641895835477563
    #define RADIUS (_1_DIV_SQRTPI * 1.05)
    #define GRID_START (0.5 + RADIUS)
    #define GRID_END (0.5 - RADIUS)
    #define GRID_STEP(dist) smoothstep(GRID_START, GRID_END, dist)

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 pos2D = getUV0();
        float dist;
        float t;

        // Default to X axis color
        vec4 color = vec4(1.0, 0.0, 0.0, 1.0);  // Red

        // Compute screen-space pixel size in world units using derivatives
        vec3 worldPos = getWorldPosition().xyz;
        float pixelSize = length(fwidth(worldPos));

        if (materialParams.axis == 0) {
            // X axis: horizontal plane, line along x at z=origin.z
            dist = abs(pos2D.y - materialParams.origin.z);
            t = pos2D.x - materialParams.origin.x;
            color = vec4(1.0, 0.0, 0.0, 1.0);  // Red for X
        } else if (materialParams.axis == 1) {
            // Y axis: vertical plane (rotated 90° around X), line along local Z (world Y) at x=origin.x
            // After rotation: pos2D.x = world X, pos2D.y = local Z = -world Y (sign flip due to rotation)
            dist = abs(pos2D.x - materialParams.origin.x);
            t = materialParams.origin.y - pos2D.y;  // Inverted to account for coordinate transform
            color = vec4(0.0, 1.0, 0.0, 1.0);  // Green for Y
        } else if (materialParams.axis == 2) {
            // Z axis: horizontal plane, line along z at x=origin.x
            dist = abs(pos2D.x - materialParams.origin.x);
            t = pos2D.y - materialParams.origin.z;
            color = vec4(0.0, 0.0, 1.0, 1.0);  // Blue for Z
        } else {
            discard;
        }

        // Use screen-space width for antialiasing
        float halfWidth = pixelSize * materialParams.lineWidth * 0.5;

        // Hard cutoff for length
        if (abs(t) > materialParams.lineLength) {
            discard;
        }

        // Hard cutoff with a small margin for antialiasing (2-3 pixels beyond the line edge)
        float aaMargin = pixelSize * 2.0;
        if (dist > halfWidth + aaMargin) {
            discard;
        }

        // Normalize distance by pixel size for smooth antialiasing
        float normalizedDist = dist / pixelSize;
        float normalizedHalfWidth = halfWidth / pixelSize;

        // Apply smoothstep for antialiased edges
        float alpha = GRID_STEP(normalizedDist - normalizedHalfWidth);

        material.baseColor = vec4(color.rgb * alpha, alpha);
    }
}
