---
const examples = [
  {
    id: 'materials_and_lighting',
    title: 'Materials and lighting',
    description: 'Animated point lights, physical materials, a shadowed ground plane, and image-based reflections.',
  },
  {
    id: 'animation',
    title: 'Skeletal animation',
    description: 'A glTF asset loaded, framed, and animated in the browser.',
  },
  {
    id: 'effects',
    title: 'Post-processing',
    description: 'Tune bloom, FXAA, exposure, temperature, tint, contrast, saturation, and vibrance live.',
  },
  {
    id: 'geometry',
    title: 'Procedural geometry',
    description: 'Native geometry buffers, materials, lighting, and camera control without a model file.',
  },
  {
    id: 'basics',
    title: 'The essentials',
    description: 'Load a model, position the camera, and orbit the scene.',
  },
] as const;

const galleryBase = '/gallery/';
---

<div class="thermion-showcase" data-thermion-showcase>
  {examples.map((example) => (
    <figure class="thermion-showcase__card">
      <figcaption class="thermion-showcase__caption">
        <span class="thermion-showcase__title">{example.title}</span>
        <span class="thermion-showcase__desc">{example.description}</span>
      </figcaption>
      <div
        class="thermion-showcase__stage"
        data-stage
        data-src={`${galleryBase}?example=${example.id}&embed=1`}
      >
        <div class="thermion-showcase__placeholder" aria-hidden="true">
          <span class="thermion-showcase__spinner"></span>
          <span>Starting renderer…</span>
        </div>
      </div>
      <div class="thermion-showcase__footer">
        <span>Drag to orbit · Scroll to zoom</span>
        <a href={`${galleryBase}?example=${example.id}`} target="_blank" rel="noreferrer">
          Open in gallery ↗
        </a>
      </div>
    </figure>
  ))}
</div>

<script>
  // Each gallery viewer boots lazily: an IntersectionObserver mounts the
  // (cross-origin-isolated) iframe as the card nears the viewport, and tears
  // it down when it leaves. DOM removal is the only reliable "pause" for a
  // cross-origin-isolated iframe — it drops the worker + GL context — so the
  // viewer fully reboots on return. Teardown is debounced so a card clipped
  // for a few frames during fast scrolling doesn't thrash its worker.
  document.querySelectorAll<HTMLElement>('[data-thermion-showcase]').forEach((showcase) => {
    if (showcase.dataset.initialized === 'true') return;
    showcase.dataset.initialized = 'true';

    const stages = Array.from(showcase.querySelectorAll<HTMLElement>('[data-stage]'));
    const teardownTimers = new WeakMap<HTMLElement, number>();

    const mount = (stage: HTMLElement) => {
      if (stage.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = stage.dataset.src!;
      iframe.title = 'Thermion interactive demo';
      iframe.allow = 'cross-origin-isolated';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.append(iframe);
      stage.classList.add('is-active');
    };

    const unmount = (stage: HTMLElement) => {
      stage.querySelector('iframe')?.remove();
      stage.classList.remove('is-active');
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const stage = entry.target as HTMLElement;
            const pending = teardownTimers.get(stage);
            if (entry.isIntersecting) {
              // Came back into range — cancel any pending teardown and boot.
              if (pending) {
                clearTimeout(pending);
                teardownTimers.delete(stage);
              }
              mount(stage);
            } else if (!pending) {
              // Left range — schedule a teardown after the debounce window.
              teardownTimers.set(
                stage,
                window.setTimeout(() => {
                  unmount(stage);
                  teardownTimers.delete(stage);
                }, 600),
              );
            }
          }
        },
        { rootMargin: '200px 0px' },
      );
      stages.forEach((stage) => observer.observe(stage));
    } else {
      // No IntersectionObserver: mount everything up front (rare/old browsers).
      stages.forEach((stage) => mount(stage));
    }
  });
</script>
