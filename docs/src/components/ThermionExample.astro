---
interface Props {
  example: 'basics' | 'geometry' | 'materials_and_lighting' | 'animation' | 'effects';
  title: string;
  description: string;
}

const { example, title, description } = Astro.props;
const galleryUrl = `https://thermion-examples.pages.dev/?example=${example}`;
const embedUrl = `${galleryUrl}&embed=1`;
---

<section class="thermion-example" data-thermion-example data-src={embedUrl}>
  <div class="thermion-example__placeholder">
    <div>
      <h3>{title}</h3>
      <p>{description}</p>
      <button type="button" data-thermion-play>Run interactive demo</button>
      <a href={galleryUrl} target="_blank" rel="noreferrer">Open in a new tab</a>
    </div>
  </div>
</section>

<script>
  const teardownActiveExample = () => {
    document.querySelectorAll<HTMLElement>('[data-thermion-example].is-active').forEach((example) => {
      example.querySelector('iframe')?.remove();
      example.classList.remove('is-active');
    });
  };

  document.querySelectorAll<HTMLElement>('[data-thermion-example]').forEach((example) => {
    if (example.dataset.initialized === 'true') return;
    example.dataset.initialized = 'true';

    example.querySelector<HTMLButtonElement>('[data-thermion-play]')?.addEventListener('click', () => {
      if (example.classList.contains('is-active')) return;
      teardownActiveExample();

      const iframe = document.createElement('iframe');
      iframe.src = example.dataset.src!;
      iframe.title = `${example.querySelector('h3')?.textContent ?? 'Thermion'} interactive demo`;
      iframe.allow = 'cross-origin-isolated';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      example.append(iframe);
      example.classList.add('is-active');
    });
  });
</script>
