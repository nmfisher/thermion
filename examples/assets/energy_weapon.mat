material {
    name : EnergyWeapon,
    shadingModel : unlit,
    requires : [ position ],
    variables : [ objectPos ],
    parameters : [
        { type : float, name : time },
        { type : float, name : mode },
        { type : float, name : phase }
    ],
    blending : add,
    depthWrite : false,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPos.xyz = getPosition().xyz;
    }
}
fragment {
    float hash(float n) {
        highp float p = fract(n * .1031);
        p *= p + 33.33;
        return fract(p * (p + p));
    }
    float line(vec2 p, vec2 a, vec2 b, float width, float aa) {
        vec2 ab = b-a;
        float u = clamp(dot(p-a,ab)/max(dot(ab,ab),.00001),0.0,1.0);
        float d = length(p-a-ab*u);
        return 1.0-smoothstep(max(0.0,width-aa),width+aa,d);
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 p = variable_objectPos.xz;
        float t = materialParams.time;
        float power = clamp(materialParams.phase,0.0,1.0);
        float cycle = mod(t,3.6);
        float aa = max(length(fwidth(p)),.0002);
        float charge = smoothstep(.15,.72,cycle)*(1.0-smoothstep(.78,1.05,cycle));
        vec3 color = vec3(0.0);

        // A stable lance, tapering toward the contact point. Most motion
        // lives in its surrounding plasma rather than in the central axis.
        float u = clamp((p.x+1.55)/3.1,0.0,1.0);
        float span = smoothstep(-1.57,-1.52,p.x)*(1.0-smoothstep(1.52,1.57,p.x));
        float anchor = sin(u*3.14159265);
        float center = .007*sin(u*9.0-t*3.0)*anchor;
        float width = mix(.063,.038,u)*(.94+.06*sin(u*19.0-t*12.0));
        float d = abs(p.y-center);
        float core = exp(-pow(d/max(width*.46,aa),4.0));
        float sheath = exp(-pow(d/width,2.0));
        float atmosphere = exp(-pow(d/(width*2.4),2.0));
        float packets = .82+.18*sin(u*35.0-t*22.0);
        color += span*power*(
            vec3(.58,.87,1.0)*core*.72 +
            vec3(.015,.23,.85)*sheath*.29*packets +
            vec3(.025,.08,.5)*atmosphere*.025);

        // Three smooth filaments wrap the bright body; their width and
        // subpixel coverage are independent of the main beam's profile.
        for (int i=0;i<3;i++) {
            float seed=float(i), angle=u*12.0-t*(4.2+seed*.7)+seed*2.094;
            float offset=sin(angle)*width*(1.15+seed*.23)*anchor;
            float filament=1.0-smoothstep(.003,max(.006,aa*1.3),abs(p.y-center-offset));
            float facing=.35+.65*(.5+.5*cos(angle));
            color+=vec3(.035,.38,1.0)*filament*facing*span*power*.18;
        }

        vec2 muzzle=p-vec2(-1.55,0.0);
        float chargeBody=exp(-pow(length(muzzle/vec2(.085,.12)),2.0));
        float mouth=exp(-pow(length(muzzle/vec2(.035,.065)),4.0));
        color+=vec3(.12,.48,1.0)*chargeBody*(charge*.24+power*.12);
        color+=vec3(.58,.85,1.0)*mouth*(charge*.3+power*.8);

        // Impact is a compressed contact flare with a backwards plume,
        // not a circular screen-space reticle.
        vec2 hit=p-vec2(1.55,0.0);
        float contact=exp(-pow(length(hit/vec2(.035,.09)),2.0));
        float backwards=1.0-smoothstep(-.015,.035,hit.x);
        float fan=exp(-pow(hit.x/.18,2.0)-pow(hit.y/(.04+abs(hit.x)*.9),2.0))*backwards;
        float churn=.65+.35*sin(hit.y*85.0+t*27.0+hit.x*40.0);
        color+=vec3(.55,.85,1.0)*contact*power*.95;
        color+=vec3(.03,.26,1.0)*fan*power*churn*.18;

        // Each spark has its own ballistic trajectory and emission phase.
        // Random seeds change only when an invisible spark is reborn.
        for (int i=0;i<12;i++) {
            float seed=float(i);
            float tick=t*3.5+hash(seed+7.0);
            float age=fract(tick), generation=floor(tick);
            float angle=1.8+hash(seed*13.0+generation*17.0)*2.65;
            vec2 velocity=vec2(cos(angle),sin(angle))*(.38+hash(seed+31.0)*.65);
            vec2 head=velocity*age+vec2(0.0,-.23*age*age);
            vec2 tail=head-velocity*(.025+.075*age);
            float spark=line(hit,head,tail,.0025+.0015*(1.0-age),aa);
            float envelope=smoothstep(0.0,.04,age)*(1.0-smoothstep(.45,1.0,age));
            color+=mix(vec3(1.0,.5,.12),vec3(.75,.88,1.0),1.0-age)*
                   spark*envelope*power*.65;
        }
        // Retain the legacy mode uniform as a muzzle-only preview.
        if (materialParams.mode>.5) {
            color=vec3(.12,.48,1.0)*chargeBody*(charge+power)*.5;
        }
        material.baseColor=vec4(color,1.0);
    }
}
