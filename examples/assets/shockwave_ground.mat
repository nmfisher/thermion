material {
    name : ShockwaveGround,
    requires : [ position ],
    variables : [
        worldPos
    ],
    parameters : [
        { type : float, name : time },
        { type : float, name : period },
        { type : float, name : waveSpeed }
    ],
    depthWrite : false,
    depthCulling : false,
    shadingModel : unlit,
    blending : add,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // getWorldPosition() in the fragment stage is view-relative on
        // this pipeline, and getWorldFromModelMatrix() returns garbage for
        // created geometry - but this plane sits at the identity
        // transform, so object position IS world position.
        material.worldPos.xyz = getPosition().xyz;
    }
}

fragment {
    float hash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    float noise2(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
                   mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
    }

    float fbm(vec2 p) {
        float v = 0.0;
        v += 0.5 * noise2(p);  p *= 2.03;
        v += 0.25 * noise2(p);
        return v / 0.75;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 pos = variable_worldPos.xyz;
        float t = materialParams.time;
        float r = length(pos.xz);

        // One wave per period, expanding from the epicenter.
        float age = mod(t, materialParams.period) / materialParams.period;
        float waveR = age * materialParams.period * materialParams.waveSpeed;

        // Razor-crisp primary Mach ground wave + trailing rarefaction ring + radial blast streaks.
        float wgt = 8.5 / (0.28 + age * 0.85);
        float drLead = (r - waveR) * wgt;
        float drWake = (r - (waveR - 0.18)) * wgt * 0.55;
        float leadRing = exp(-drLead * drLead);
        float wakeRing = exp(-drWake * drWake) * 0.48;
        float drSecond = (r - waveR * 0.74) * wgt * 1.15;
        float echoRing = exp(-drSecond * drSecond) * 0.52;

        // Radial supersonic ejecta streaks scoured across the ground behind the shock front.
        float ang = atan(pos.z, pos.x);
        float radialRays = pow(0.5 + 0.5 * sin(ang * 24.0 + noise2(pos.xz * 3.5) * 3.0), 4.0);
        float radialZone = smoothstep(waveR + 0.05, waveR - 0.45, r) * smoothstep(0.08, 0.35, r);
        float rays = radialRays * radialZone * exp(-abs(r - waveR * 0.88) * 2.2) * 0.85;

        // Glowing epicenter plasma crater that cools after detonation.
        float epiCore = exp(-r * r * 6.5) * exp(-age * 5.5) * 2.8;
        float epiHalo = exp(-r * 1.35) * (1.0 - age) * 0.38;

        float arc = 0.45 + 0.75 * fbm(pos.xz * 2.1 + t * 0.25);
        float churn = 0.75 + 0.45 * noise2(pos.xz * 7.5 - t * 3.5);
        float fade = pow(1.0 - age, 1.75);

        vec3 cyanFront = vec3(0.72, 0.95, 1.0);
        vec3 cobalt = vec3(0.10, 0.45, 1.0);
        vec3 violet = vec3(0.42, 0.16, 0.95);

        vec3 rgb = cyanFront * (leadRing * 2.6 + epiCore) +
                   cobalt * (wakeRing * 1.6 + rays * 1.4 + epiHalo) +
                   violet * (echoRing * 1.35);

        material.baseColor = vec4(rgb * arc * churn * fade * 0.062, 1.0);
    }
}
