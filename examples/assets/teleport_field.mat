material {
    name : TeleportField, shadingModel : unlit,
    requires : [ position ], variables : [ objectPos ],
    parameters : [ { type : float, name : time }, { type : float, name : strength }, { type : float, name : isBeam } ],
    blending : add, depthWrite : false, culling : none
}
vertex { void materialVertex(inout MaterialVertexInputs m) { m.objectPos.xyz=getPosition().xyz; } }
fragment {
    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec3 obj = variable_objectPos.xyz;
        if (materialParams.isBeam > 0.5) {
            float h = clamp(obj.y + 0.5, 0.0, 1.0);
            float angle = atan(obj.z, obj.x + 0.00001);
            float streaks = 0.42 + 0.58 * sin(angle * 12.0 - materialParams.time * 5.0 + h * 8.0);
            float scan = 0.68 + 0.32 * sin(h * 28.0 - materialParams.time * 10.0);
            float vFade = smoothstep(0.0, 0.10, h) * (1.0 - smoothstep(0.55, 0.98, h)) * exp(-h * 1.85);
            vec3 beamCol = mix(vec3(0.06, 0.52, 1.0), vec3(0.42, 0.22, 1.0), h);
            m.baseColor = vec4(beamCol * vFade * streaks * scan * materialParams.strength * 0.055, 1.0);
            return;
        }
        vec2 p = obj.xz;
        float r = length(p), a = atan(p.y, p.x + .00001), aa = max(length(fwidth(p)), .002);
        float outerRing = 1.0 - smoothstep(.005, .014 + aa, abs(r - .76));
        float midRing = (1.0 - smoothstep(.005, .014 + aa, abs(r - .62))) *
                        smoothstep(-.25, .25, sin(a * 8.0 + materialParams.time * 1.4));
        float innerRing = (1.0 - smoothstep(.004, .012 + aa, abs(r - .42))) *
                          smoothstep(-.15, .35, sin(a * 6.0 - materialParams.time * 2.1));
        float ticks = pow(max(0.0, cos(a * 24.0)), 24.0) *
                      smoothstep(.64, .67, r) * (1.0 - smoothstep(.73, .76, r));
        // Expanding energy pulse wave across the pad.
        float waveR = fract(materialParams.time * 0.65) * 0.76;
        float pulseRing = exp(-pow((r - waveR) * 28.0, 2.0)) * (1.0 - waveR / 0.76);
        float coreGlow = exp(-r * r * 5.5) * .12;

        vec3 cyan = vec3(.14, .68, 1.0);
        vec3 whiteHot = vec3(.75, .95, 1.0);
        vec3 rgb = cyan * (midRing * .22 + innerRing * .18 + ticks * .24 + coreGlow) +
                   whiteHot * (outerRing * .28 + pulseRing * .24);
        m.baseColor = vec4(rgb * materialParams.strength, 1.0);
    }
}
