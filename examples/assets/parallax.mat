material {
    name : ParallaxOcclusion,
    shadingModel : lit,
    customSurfaceShading : true,
    requires : [
        uv0,
        tangents
    ],
    parameters : [
        {
            type : sampler2d,
            name : albedoMap
        },
        {
            type : sampler2d,
            name : heightMap,
            precision : high
        },
        {
            type : sampler2d,
            name : normalMap
        },
        {
            type : float,
            name : heightScale,
            precision : high
        },
        {
            type : float,
            name : minSteps,
            precision : high
        },
        {
            type : float,
            name : maxSteps,
            precision : high
        },
        {
            type : float,
            name : normalStrength
        },
        {
            type : float,
            name : shadowStrength
        },
        {
            type : float,
            name : shadowSteps,
            precision : high
        },
        {
            type : float,
            name : shadowBias,
            precision : high
        },
        {
            type : float4,
            name : tintColor
        },
        {
            type : float,
            name : roughnessFactor
        },
        {
            type : float,
            name : metallicFactor
        },
        {
            type : int,
            name : debugView
        }
    ],
    depthWrite : true,
    culling : back
}

fragment {
    // Per-fragment intersection and derivatives, initialized by material()
    // before Filament invokes surfaceShading() separately for each light.
    highp vec2 pomShadowUV;
    highp float pomShadowDepth;
    highp vec2 pomShadowDx;
    highp vec2 pomShadowDy;
    highp vec2 pomTexelDensity;

    highp float pomLightVisibility(highp vec3 worldLight) {
        if (materialParams.heightScale <= 1e-6 ||
            materialParams.shadowStrength <= 0.0 || materialParams.debugView != 0) {
            return 1.0;
        }

        highp vec3 lightTS = normalize(transpose(getWorldTangentFrame()) * worldLight);
        // A light below the geometric horizon cannot illuminate this opaque
        // height field, even if the normal map tilts toward it.
        if (lightTS.z <= 0.0) {
            return 0.0;
        }

        // Bias is in normalized height units, independent of heightScale.
        // Raise the ray origin slightly to avoid self-intersection from the
        // finite precision of the height texture and the view-ray refinement.
        highp float startDepth = max(pomShadowDepth - clamp(materialParams.shadowBias, 0.0, 0.1), 0.0);
        if (startDepth <= 0.0) {
            return 1.0;
        }

        // Follow the light-directed ray OUT of the volume, from the actual
        // displaced hit to its top. Punctual lights are locally approximated
        // by lightData.l and are assumed to lie outside the shallow volume.
        highp vec2 rayOffset = lightTS.xy * (materialParams.heightScale * startDepth / max(lightTS.z, 1e-4));
        highp float maxSteps = clamp(floor(materialParams.shadowSteps), 4.0, 512.0);
        highp float steps = clamp(ceil(2.0 * length(rayOffset * pomTexelDensity)), 4.0, maxSteps);
        for (int i = 0; i < 512; i++) {
            if (float(i) >= steps) {
                break;
            }
            highp float t = min(float(i + 1) / steps, 1.0);
            highp float rayDepth = startDepth * (1.0 - t);
            highp vec2 sampleUV = pomShadowUV + rayOffset * t;
            highp float surfaceDepth = 1.0 - textureGrad(materialParams_heightMap, sampleUV, pomShadowDx, pomShadowDy).r;
            if (rayDepth > surfaceDepth) {
                return 0.0;
            }
        }
        return 1.0;
    }

    highp vec3 surfaceShading(const MaterialInputs materialInputs,
            const ShadingData shadingData, const LightData lightData) {
        if (lightData.NdotL <= 0.0 || lightData.visibility <= 0.0 || lightData.attenuation <= 0.0) {
            return vec3(0.0);
        }
        highp float shadow = mix(1.0, pomLightVisibility(lightData.l),
                clamp(materialParams.shadowStrength, 0.0, 1.0));
        if (shadow <= 0.0) {
            return vec3(0.0);
        }

        // Isotropic GGX + correlated Smith visibility + Schlick Fresnel and
        // Lambert diffuse, using only Filament's public custom-shading API.
        // The hook replaces direct lighting; Filament still evaluates IBL.
        highp vec3 n = getWorldNormalVector();
        highp vec3 v = getWorldViewVector();
        highp vec3 h = normalize(v + lightData.l);
        highp float NoV = max(dot(n, v), 1e-4);
        highp float NoL = lightData.NdotL;
        highp float NoH = clamp(dot(n, h), 0.0, 1.0);
        highp float LoH = clamp(dot(lightData.l, h), 0.0, 1.0);
        highp float alpha2 = shadingData.roughness * shadingData.roughness;
        highp float denominator = NoH * NoH * (alpha2 - 1.0) + 1.0;
        highp float distribution = alpha2 / max(PI * denominator * denominator, 1e-12);
        highp float smithV = NoL * sqrt(NoV * NoV * (1.0 - alpha2) + alpha2);
        highp float smithL = NoV * sqrt(NoL * NoL * (1.0 - alpha2) + alpha2);
        highp float visibility = 0.5 / max(smithV + smithL, 1e-6);
        highp vec3 fresnel = shadingData.f0 + (1.0 - shadingData.f0) * pow5(1.0 - LoH);
        highp vec3 brdf = shadingData.diffuseColor / PI + distribution * visibility * fresnel;
        return brdf * lightData.colorIntensity.rgb *
                (lightData.colorIntensity.w * lightData.attenuation * NoL * lightData.visibility * shadow);
    }

    void material(inout MaterialInputs material) {
        // Filament defaults to mediump on mobile (half on Metal). Ray UVs
        // and depths need highp so small steps and refinement do not vanish.
        highp vec2 uv = getUV0();

        // The engine's own tangent frame (same TBN applied to material.normal)
        // and view vector. shading_view points from the surface toward the eye.
        highp mat3 tangentFrame = getWorldTangentFrame();
        highp vec3 tsView = normalize(transpose(tangentFrame) * getWorldViewVector());

        // ------------------------------------------------------------------
        // Parallax occlusion mapping: march the view ray through the height
        // field (1.0 = surface top, 0.0 = deepest), then binary-search the
        // height crossing between the last two samples.
        //
        // Capture derivatives before the divergent march and use textureGrad
        // throughout. This keeps mip selection stable and preserves the
        // sampler's anisotropic filtering at grazing angles.
        // ------------------------------------------------------------------
        highp vec2 pomUV = uv;
        highp float uvOffset = 0.0;
        highp float heightScale = max(materialParams.heightScale, 0.0);
        highp vec2 uvDx = dFdx(uv);
        highp vec2 uvDy = dFdy(uv);
        pomShadowUV = uv;
        pomShadowDepth = 0.0;
        pomShadowDx = uvDx;
        pomShadowDy = uvDy;
        pomTexelDensity = vec2(0.0);

        if (heightScale > 1e-6 &&
           (materialParams.debugView == 0 ||
            materialParams.debugView == 1 ||
            materialParams.debugView == 2 ||
            materialParams.debugView == 5)) {
            highp float minLayers = clamp(ceil(min(materialParams.minSteps, materialParams.maxSteps)), 4.0, 512.0);
            highp float maxLayers = clamp(floor(max(materialParams.minSteps, materialParams.maxSteps)), minLayers, 512.0);

            // The march follows the ray INTO the surface: opposite to the
            // eye-directed view vector. Clamp grazing angles so the slide
            // distance stays bounded.
            highp vec2 rayOffset = -tsView.xy * heightScale / max(abs(tsView.z), 0.08);

            // Aim for two samples per filtered texel along the whole ray.
            // The minor axis of the UV footprint is a conservative estimate
            // of mip texel size even with anisotropic filtering. Using the
            // major axis would undersample the detail anisotropy preserves.
            highp vec2 texSize = vec2(textureSize(materialParams_heightMap, 0));
            highp vec2 dx = uvDx * texSize;
            highp vec2 dy = uvDy * texSize;
            highp float a = dot(dx, dx);
            highp float b = dot(dx, dy);
            highp float c = dot(dy, dy);
            highp float majorSquared = 0.5 * (a + c + sqrt((a - c) * (a - c) + 4.0 * b * b));
            highp float minor = abs(dx.x * dy.y - dx.y * dy.x) / sqrt(max(majorSquared, 1e-12));
            pomTexelDensity = texSize / max(minor, 1.0);
            highp float texelSteps = ceil(2.0 * length(rayOffset * texSize) / max(minor, 1.0));
            // maxSteps is a hard work budget. Very thin features can still
            // be missed when it is exhausted; refinement cannot recover them.
            highp float numLayers = clamp(texelSteps, minLayers, maxLayers);

            highp float curLayer = 0.0;
            highp float prevLayer = 0.0;
            // The ray starts at the top of the displacement volume. Convert
            // height (1 = top) to depth below that plane (0 = top).
            highp float residual = textureGrad(materialParams_heightMap, uv, uvDx, uvDy).r - 1.0;
            highp float prevResidual = residual;
            for (int i = 0; i < 512; i++) {
                if (residual >= 0.0 || float(i) >= numLayers) {
                    break;
                }
                prevLayer = curLayer;
                prevResidual = residual;
                // Compute from the index, not repeated additions: the last
                // step lands exactly at depth 1, including for a black map.
                curLayer = min(float(i + 1) / numLayers, 1.0);
                highp vec2 curUV = uv + rayOffset * curLayer;
                residual = curLayer - (1.0 - textureGrad(materialParams_heightMap, curUV, uvDx, uvDy).r);
            }

            if (residual >= 0.0 && curLayer > 0.0) {
                highp float beforeDepth = prevLayer;
                highp float afterDepth = curLayer;
                for (int j = 0; j < 4; j++) {
                    highp float midDepth = 0.5 * (beforeDepth + afterDepth);
                    highp vec2 midUV = uv + rayOffset * midDepth;
                    highp float midResidual = midDepth - (1.0 - textureGrad(materialParams_heightMap, midUV, uvDx, uvDy).r);
                    if (midResidual >= 0.0) {
                        afterDepth = midDepth;
                        residual = midResidual;
                    } else {
                        beforeDepth = midDepth;
                        prevResidual = midResidual;
                    }
                }
                // Interpolate the final bracket to hit constant heights and
                // locally linear profiles without a midpoint bias.
                highp float weight = clamp(-prevResidual / max(residual - prevResidual, 1e-8), 0.0, 1.0);
                pomShadowDepth = mix(beforeDepth, afterDepth, weight);
                pomUV = uv + rayOffset * pomShadowDepth;
            }
            uvOffset = length(pomUV - uv);
        }
        pomShadowUV = pomUV;

        // Normal mapping in tangent space. The engine transforms this with
        // the same tangent frame returned above, so the parallaxed normal
        // sample and the march share one frame by construction.
        // normalStrength 0 collapses to the geometric normal (0, 0, 1).
        vec3 nTS = textureGrad(materialParams_normalMap, pomUV, uvDx, uvDy).xyz * 2.0 - 1.0;
        nTS = mix(vec3(0.0, 0.0, 1.0), nTS, clamp(materialParams.normalStrength, 0.0, 1.0));
        material.normal = normalize(nTS);
        prepareMaterial(material);

        material.roughness = materialParams.roughnessFactor;
        material.metallic = materialParams.metallicFactor;

        if (materialParams.debugView == 1) {
            // Height map at the parallaxed uv (display-remapped: the opaque
            // path lifts near-black values hard toward mid-gray).
            float h = textureGrad(materialParams_heightMap, pomUV, uvDx, uvDy).r;
            material.baseColor = vec4(vec3(clamp(h * 0.7 + 0.15, 0.0, 1.0)), 1.0);
        } else if (materialParams.debugView == 2) {
            // Slide magnitude in units of heightScale (saturates at grazing).
            highp float d = clamp(uvOffset / max(heightScale, 1e-4), 0.0, 1.0);
            material.baseColor = vec4(vec3(clamp(d * 0.7 + 0.15, 0.0, 1.0)), 1.0);
        } else if (materialParams.debugView == 3) {
            // Tangent-space view vector: R/G = |x|/|y| (slide axes),
            // B = z (facing term; near 1 head-on, near 0 at grazing).
            material.baseColor = vec4(abs(tsView.x), abs(tsView.y), clamp(tsView.z, 0.0, 1.0), 1.0);
        } else if (materialParams.debugView == 5) {
            // Signed uv slide for direction debugging: du in R, dv in G,
            // neutral 0.5. For a correct march the mean du sign must match
            // -(view.u/view.z) in the texture's uv frame.
            highp vec2 d = (pomUV - uv) / max(heightScale, 1e-4);
            material.baseColor = vec4(clamp(0.5 + d.x * 0.5, 0.0, 1.0),
                                      clamp(0.5 + d.y * 0.5, 0.0, 1.0),
                                      0.5, 1.0);
        } else {
            vec4 albedo = textureGrad(materialParams_albedoMap, pomUV, uvDx, uvDy);
            material.baseColor = vec4(albedo.rgb * materialParams.tintColor.rgb, 1.0);
        }
    }
}
