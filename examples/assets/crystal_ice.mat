material {
    name : CrystalIce,
    shadingModel : lit,
    requires : [ position, tangents ],
    variables : [ objectPos, surfaceNormal, worldPos ],
    parameters : [
        { type : float, name : time },
        { type : float4, name : tint }
    ],
    blending : transparent,
    depthWrite : false,
    culling : back,
    variantFilter : [ skinning ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPos.xyz = getPosition().xyz;
        material.surfaceNormal.xyz = material.worldNormal;
        material.worldPos.xyz = (getWorldFromModelMatrix() * vec4(getPosition().xyz, 1.0)).xyz;
    }
}
fragment {
    float hash(vec3 p) {
        p = fract(p * .1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
    }

    // Returns (F1, F2 - F1, cellId): F2 - F1 is 0 along true 3D crystal cleavage planes!
    vec3 voronoiCrystal(vec3 x) {
        vec3 n = floor(x), f = fract(x);
        float f1 = 8.0, f2 = 8.0, id = 0.0;
        for (int k = -1; k <= 1; k++) {
            for (int j = -1; j <= 1; j++) {
                for (int i = -1; i <= 1; i++) {
                    vec3 g = vec3(float(i), float(j), float(k));
                    vec3 cell = n + g;
                    vec3 o = vec3(hash(cell), hash(cell + 17.0), hash(cell + 41.0));
                    vec3 r = g + o - f;
                    float d = dot(r, r);
                    if (d < f1) {
                        f2 = f1;
                        f1 = d;
                        id = o.x;
                    } else if (d < f2) {
                        f2 = d;
                    }
                }
            }
        }
        float d1 = sqrt(f1), d2 = sqrt(f2);
        return vec3(d1, d2 - d1, id);
    }

    float iceNoise(vec3 p) {
        vec3 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x),
                       mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
                   mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),
                       mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z);
    }

    void material(inout MaterialInputs material) {
        vec3 p = variable_objectPos.xyz;
        vec3 wp = variable_worldPos.xyz;
        vec3 n = normalize(variable_surfaceNormal.xyz);
        vec3 v = getWorldViewVector();

        // Subtle micro-chiseled glacial surface relief (frosty only right at the ground contact).
        float heightNorm = clamp((p.y + 0.05) / 0.95, 0.0, 1.0);
        float baseFrost = (1.0 - smoothstep(0.0, 0.16, heightNorm)) * (0.4 + 0.6 * iceNoise(wp * 11.0));
        float microA = iceNoise(wp * 14.0);
        float microB = iceNoise(wp * 14.0 + vec3(0.08, 0.0, 0.0));
        float microC = iceNoise(wp * 14.0 + vec3(0.0, 0.08, 0.0));
        vec2 surfSlope = vec2(microB - microA, microC - microA) * (0.18 + 1.2 * baseFrost);
        material.normal = normalize(vec3(-surfSlope, 1.0));
        prepareMaterial(material);

        vec3 worldN = getWorldNormalVector();
        float ndv = clamp(abs(dot(worldN, v)), 0.04, 1.0);
        float fresnel = pow(1.0 - ndv, 3.0);
        float rimLip = pow(1.0 - ndv, 6.5);

        // Deep parallax-refracted internal crystal structure (soft volumetric facets
        // and sparse internal glint planes — NO surface Voronoi spiderweb!).
        vec3 refr = refract(-v, worldN, 1.0 / 1.31);
        vec3 sampleDeep = wp * 2.6 + p * 1.5 + refr * 0.42;
        vec3 vDeep = voronoiCrystal(sampleDeep);

        // Sparse internal cleavage glints visible only when catching the light inside the core.
        vec3 sunDir = normalize(vec3(0.55, 0.68, 0.48));
        float internalSpec = pow(max(dot(reflect(-v, normalize(worldN + (vDeep.z - 0.5) * 0.35)), sunDir), 0.0), 18.0);
        float internalFracture = (1.0 - smoothstep(0.006, 0.026, vDeep.y)) *
                                 step(0.58, vDeep.z) * (0.25 + 1.4 * internalSpec) *
                                 (1.0 - fresnel * 0.7);

        // Subsurface glacial scattering: deep sapphire core, glowing cyan-aquamarine spire tips & edges.
        float backLight = pow(max(dot(-v, sunDir - worldN * 0.4), 0.0), 2.8);
        float tipScatter = smoothstep(0.35, 1.0, heightNorm);

        // Translucent glacier quartz: overlapping crystal shards remain visible
        // through each other (blending: transparent), while PBR specular + IBL +
        // frosty rime base + internal parallax caustics sell the 3D crystal volume!
        float rime = clamp(baseFrost * 0.52, 0.0, 0.44);
        float thickness = mix(1.25, 0.48, tipScatter) * (0.78 + 0.45 * vDeep.x) / max(ndv, 0.25);
        vec3 absorption = exp(-vec3(2.9, 0.78, 0.16) * thickness * 0.68);
        vec3 bodyColor = mix(vec3(0.028, 0.19, 0.42) * absorption, vec3(0.22, 0.44, 0.64), rime);
        float alpha = clamp(mix(0.56 + fresnel * 0.34, 0.86, rime), 0.0, 0.94) * materialParams.tint.a;

        material.baseColor = vec4(bodyColor, alpha);
        material.metallic = 0.0;
        material.roughness = mix(0.035, 0.42, rime);
        material.reflectance = 0.55;

        float pulse = 0.9 + 0.1 * sin(materialParams.time * 1.8 + wp.y * 4.0);
        vec3 innerGlow = materialParams.tint.rgb * (0.04 + 0.22 * backLight + 0.10 * tipScatter) * absorption +
                         vec3(0.32, 0.84, 1.0) * internalFracture * 0.24 * pulse +
                         mix(vec3(0.16, 0.66, 0.98), vec3(0.52, 0.38, 0.96), 0.5 + 0.5 * worldN.x) *
                             (fresnel * 0.18 + rimLip * 0.42);
        material.emissive = vec4(innerGlow, 0.0);
    }
}
