material {
    name : Wireframe,
    parameters : [
        {
            type: float4,
            name: edgeColor,
            default: [1.0, 1.0, 1.0, 1.0]
        },
        {
            type: float4,
            name: faceColor,
            default: [0.2, 0.2, 0.2, 0.3]
        },
        {
            type: float,
            name: edgeWidth,
            default: 1.5
        }
    ],
    requires : [
        uv0
    ],
    variables : [
        barycentrics
    ],
    depthWrite : true,
    depthCulling : true,
    doubleSided : false,
    shadingModel : unlit,
    blending : transparent,
    culling : back
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Barycentric coordinates should be stored in UV0:
        // vertex 0: (1, 0), vertex 1: (0, 1), vertex 2: (0, 0)
        // We reconstruct the third component as 1 - u - v
        vec2 uv = material.uv0;
        material.barycentrics = vec4(uv.x, uv.y, 1.0 - uv.x - uv.y, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Get barycentric coordinates passed from vertex shader
        vec3 bary = variable_barycentrics.xyz;

        // Calculate edge proximity using screen-space derivatives for antialiasing
        vec3 d = fwidth(bary);
        vec3 edge = smoothstep(vec3(0.0), d * materialParams.edgeWidth, bary);
        float edgeFactor = min(min(edge.x, edge.y), edge.z);

        // edgeFactor is 0 at edges, 1 in interior
        // Mix: edge color when edgeFactor is 0, face color when edgeFactor is 1
        material.baseColor = mix(materialParams.edgeColor, materialParams.faceColor, edgeFactor);
    }
}
