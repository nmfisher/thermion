material {
    name : SolidColor,
    shadingModel : unlit,
    culling : none,
    featureLevel : 1,
    vertexDomain: object,
    parameters : [
    {
        type : float4,
        name : color
    }],
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
    }
}
