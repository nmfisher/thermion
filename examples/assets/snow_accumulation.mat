material {
    name : SnowAccumulation,
    shadingModel : unlit,
    requires : [ position, tangents ],
    variables : [ objectPos, surfaceNormal ],
    parameters : [
        { type : float, name : time },
        { type : float, name : accumulation }
    ],
    culling : none,
    variantFilter : [ shadowReceiver, vsm ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPos.xyz = getPosition().xyz;
        material.surfaceNormal.xyz = material.worldNormal;
    }
}
fragment {
    float hash(vec3 p) { return fract(sin(dot(p, vec3(127.1,311.7,74.7))) * 43758.5453); }
    float noise3(vec3 p) {
        vec3 i=floor(p),f=fract(p); f=f*f*(3.0-2.0*f);
        return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 p=variable_objectPos.xyz, n=normalize(variable_surfaceNormal.xyz);
        float slope=smoothstep(.12,.72,n.y);
        float banks=noise3(p*5.5)*.18+noise3(p*15.0)*.06;
        float amount = clamp(materialParams.accumulation, 0.0, 1.0);
        // Deposition follows upward-facing surfaces, with a broken border.
        // Increasing accumulation lowers the required slope, not a flat
        // horizontal clipping plane passing through the entire object.
        float threshold = mix(1.08, 0.08, amount);
        float cover = smoothstep(threshold-.09, threshold+.09, slope + banks-.12);
        cover *= smoothstep(0.0, .08, amount);
        float grain = noise3(p*65.0);
        float frost = smoothstep(.76,.94,grain)*cover;
        vec3 substrate=mix(vec3(.008,.011,.016),vec3(.055,.026,.012),noise3(p*7.0));
        vec3 snow=mix(vec3(.05,.10,.17),vec3(.34,.43,.52),slope)*(.85+.15*noise3(p*18.0));
        vec3 key=normalize(vec3(-.45,.75,.48));
        float diffuse=.18+.82*max(dot(n,key),0.0);
        vec3 view = getWorldViewVector();
        float rim=pow(1.0-abs(dot(n,view)),3.0);
        vec3 color=mix(substrate,snow,cover)*diffuse;
        color+=vec3(.07,.16,.25)*rim*(.25+.75*cover);
        float glint = pow(max(dot(n,normalize(key+view)),0.0),96.0);
        color+=vec3(.55,.78,1.0)*frost*glint*.45;
        material.baseColor=vec4(color,1.0);
    }
}
