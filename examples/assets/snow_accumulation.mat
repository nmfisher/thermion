material {
    name : SnowAccumulation,
    shadingModel : lit,
    requires : [ position, tangents ],
    variables : [ objectPos, surfaceNormal ],
    parameters : [
        { type : float, name : time },
        { type : float, name : accumulation }
    ],
    culling : back,
    variantFilter : [ skinning ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPos.xyz = getPosition().xyz;
        material.surfaceNormal.xyz = material.worldNormal;
        // Subtle pillowy upward snow lofting on top-facing surfaces as snow piles up.
        float up = smoothstep(0.15, 0.85, material.worldNormal.y);
        float loft = up * clamp(materialParams.accumulation, 0.0, 1.0) * 0.022;
        material.worldPosition.xyz += vec3(0.0, loft, 0.0) + material.worldNormal * (loft * 0.35);
    }
}
fragment {
    float hash(vec3 p) {
        p = fract(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
    }
    float noise3(vec3 p) {
        vec3 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x),
                       mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
                   mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),
                       mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z);
    }
    float fbm(vec3 p) {
        return 0.55 * noise3(p) + 0.30 * noise3(p * 2.13 + 7.1) + 0.15 * noise3(p * 4.41 + 19.3);
    }
    void material(inout MaterialInputs material) {
        vec3 p = variable_objectPos.xyz;
        vec3 n = normalize(variable_surfaceNormal.xyz);
        // Wind-driven directional snow loading (slightly windward +X/+Z + upward +Y).
        float windSlope = smoothstep(0.04, 0.74, dot(n, normalize(vec3(0.22, 0.95, 0.20))));
        float drifts = fbm(p * 7.5) * 0.24 + noise3(p * 22.0) * 0.08;
        float amount = clamp(materialParams.accumulation, 0.0, 1.0);
        float threshold = mix(1.12, 0.06, amount);
        float cover = smoothstep(threshold - 0.10, threshold + 0.10, windSlope + drifts - 0.12);
        cover *= smoothstep(0.0, 0.06, amount);
        float frostRim = smoothstep(threshold - 0.24, threshold - 0.04, windSlope + drifts - 0.12) *
                         (1.0 - cover) * smoothstep(0.02, 0.18, amount);

        // Fluffy wind-rippled snow micro-normals vs smooth metallic/leather helmet substrate.
        float sA = fbm(p * 26.0);
        float sB = fbm(p * 26.0 + vec3(0.035, 0.0, 0.0));
        float sC = fbm(p * 26.0 + vec3(0.0, 0.0, 0.035));
        vec2 snowSlope = vec2(sB - sA, sC - sA) * 1.65 * cover;
        material.normal = normalize(vec3(-snowSlope, 1.0));
        prepareMaterial(material);

        // Substrate: weathered aviation bronze/leather vs crisp sunlit alpine snow.
        float subVar = fbm(p * 9.0 + 3.0);
        vec3 substrate = mix(vec3(0.055, 0.048, 0.044), vec3(0.18, 0.11, 0.065), subVar);
        vec3 snowAlbedo = mix(vec3(0.68, 0.78, 0.90), vec3(0.88, 0.93, 0.98), sA);
        vec3 albedo = mix(substrate, vec3(0.48, 0.60, 0.74), frostRim * 0.65);
        albedo = mix(albedo, snowAlbedo, cover);

        material.baseColor = vec4(albedo, 1.0);
        material.metallic = mix(0.62, 0.0, clamp(cover + frostRim * 0.5, 0.0, 1.0));
        material.roughness = mix(0.32, 0.74, cover);

        // Sparkling discrete ice-crystal facet glints + cool glacial subsurface scatter.
        vec3 V = getWorldViewVector();
        vec3 key = normalize(vec3(0.35, 0.82, 0.45));
        vec3 cell = floor(p * 135.0);
        vec3 facetN = normalize(n + (vec3(hash(cell), hash(cell + 13.0), hash(cell + 29.0)) - 0.5) * 0.85);
        float sparkle = pow(max(dot(facetN, normalize(key + V)), 0.0), 64.0) *
                        step(0.68, hash(cell + 51.0)) * cover;
        float sss = pow(1.0 - clamp(abs(dot(getWorldNormalVector(), V)), 0.0, 1.0), 2.5) * cover;
        material.emissive = vec4(vec3(0.03, 0.07, 0.14) * sss + vec3(0.85, 0.95, 1.0) * sparkle * 1.35, 0.0);
    }
}
