material {
    name : DissolveBurn,
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : edgeColor },
        { type : float,  name : threshold },
        { type : float,  name : edgeWidth },
        { type : float,  name : edgeIntensity },
        { type : float,  name : noiseScale },
        { type : float,  name : time }
    ],
    depthWrite : true,
    depthCulling : true,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    variantFilter : [ shadowReceiver, vsm ]
}

fragment {
    float hash(vec3 p) {
        p = fract(p * vec3(443.897, 441.423, 437.195));
        p += dot(p, p.yzx + 19.19);
        return fract((p.x + p.y) * p.z);
    }

    float noise3(vec3 p) {
        vec3 i = floor(p);
        vec3 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
            mix(mix(hash(i),                 hash(i + vec3(1, 0, 0)), f.x),
                mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
            mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
                mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y),
            f.z);
    }

    float fbm(vec3 p) {
        float v = 0.0;
        v += 0.5 * noise3(p);  p *= 2.01;
        v += 0.25 * noise3(p); p *= 2.02;
        v += 0.125 * noise3(p);
        return v / 0.875;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 pos = getWorldPosition().xyz;
        float n = fbm(pos * materialParams.noiseScale +
                      vec3(0.0, 0.0, materialParams.time * 0.15));

        float t = clamp(materialParams.threshold, 0.0, 1.0);
        if (n < t) {
            discard;
        }

        // Fragments within edgeWidth of the threshold glow as burning edges.
        float edge = smoothstep(t, t + materialParams.edgeWidth, n);
        float glow = (1.0 - edge) * materialParams.edgeIntensity;

        vec3 color = materialParams.baseColor.rgb * (0.4 + 0.6 * n);
        color += materialParams.edgeColor.rgb * glow;

        material.baseColor = vec4(color, 1.0);
    }
}
