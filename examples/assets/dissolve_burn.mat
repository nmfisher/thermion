material {
    name : DissolveBurn,
    shadingModel : lit,
    requires : [ position, tangents ],
    variables : [
        objectPos,
        surfaceNormal
    ],
    parameters : [
        { type : float4, name : baseColor },
        { type : float4, name : edgeColor },
        { type : float,  name : threshold },
        { type : float,  name : edgeWidth },
        { type : float,  name : edgeIntensity },
        { type : float,  name : noiseScale },
        { type : float,  name : time }
    ],
    blending : masked,
    maskThreshold : 0.5,
    doubleSided : true,
    variantFilter : [ skinning ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPos.xyz = getPosition().xyz;
        material.surfaceNormal.xyz = material.worldNormal;
    }
}

fragment {
    float hash(vec3 p) {
        p = fract(p * vec3(443.897, 441.423, 437.195));
        p += dot(p, p.yzx + 19.19);
        return fract((p.x + p.y) * p.z);
    }

    float noise3(vec3 p) {
        vec3 i = floor(p);
        vec3 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
            mix(mix(hash(i),                 hash(i + vec3(1, 0, 0)), f.x),
                mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
            mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),
                mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y),
            f.z);
    }

    float fbm(vec3 p) {
        float v = 0.0;
        v += 0.5 * noise3(p);    p *= 2.03;
        v += 0.25 * noise3(p);   p *= 2.01;
        v += 0.125 * noise3(p);  p *= 2.02;
        v += 0.0625 * noise3(p);
        return v / 0.9375;
    }

    void material(inout MaterialInputs material) {
        vec3 pos = variable_objectPos.xyz;
        vec3 domain = pos * materialParams.noiseScale;
        float n = fbm(domain + vec3(noise3(domain * 0.7), noise3(domain * 0.7 + 17.0), 0.0));
        n = mix(n, noise3(domain * 6.5), 0.15);

        float t = clamp(materialParams.threshold, 0.0, 1.0);
        float alpha = step(t, n);

        // Distance from the receding burn front: 0 right on the molten edge, 1 past it.
        float width = max(materialParams.edgeWidth, 0.001) * 1.45;
        float e = clamp((n - t) / width, 0.0, 1.0);
        float front = 1.0 - e;

        // Blistered rough carbon char crust ahead of the active combustion zone.
        float charr = 1.0 - smoothstep(t + width * 0.4, t + width * 3.4, n);
        float blisterA = noise3(pos * 42.0);
        float blisterB = noise3(pos * 42.0 + vec3(0.04, 0.0, 0.0));
        float blisterC = noise3(pos * 42.0 + vec3(0.0, 0.04, 0.0));
        vec2 charSlope = vec2(blisterB - blisterA, blisterC - blisterA) * (0.2 + 2.4 * charr);
        material.normal = normalize(vec3(-charSlope, 1.0));
        prepareMaterial(material);

        // Blackbody thermal gradient: blinding white-yellow -> molten orange -> deep cherry ember.
        vec3 hot = vec3(1.0, 0.97, 0.84);
        vec3 mid = materialParams.edgeColor.rgb * vec3(1.25, 0.95, 0.75);
        vec3 cool = vec3(0.48, 0.035, 0.004);
        vec3 edgeCol = mix(hot, mid, smoothstep(0.04, 0.36, e));
        edgeCol = mix(edgeCol, cool, smoothstep(0.36, 1.0, e));

        float flicker = 0.76 + 0.32 * noise3(pos * 8.0 + vec3(0.0, materialParams.time * 6.0, 0.0)) +
                        0.18 * noise3(pos * 18.0 + vec3(0.0, materialParams.time * 11.0, 0.0));
        float glow = pow(front, 1.9) * materialParams.edgeIntensity * flicker;

        // Glowing subsurface ember cracks meandering through the blackened char crust.
        float crackNoise = abs(noise3(pos * 24.0 + 9.0) - 0.5);
        float emberCracks = (1.0 - smoothstep(0.0, 0.055, crackNoise)) * pow(charr, 1.6) * flicker;
        float spark = step(0.985, hash(floor(pos * 52.0) + floor(materialParams.time * 10.0))) * pow(front, 3.2);

        // Intact tactical bronze/gunmetal PBR surface darkening into matte soot/char.
        float detail = fbm(pos * materialParams.noiseScale * 2.8 + 31.0);
        vec3 intactAlbedo = mix(materialParams.baseColor.rgb * 1.45,
                                materialParams.baseColor.rgb * vec3(1.9, 1.55, 1.25),
                                detail);
        vec3 charAlbedo = vec3(0.012, 0.011, 0.012);
        material.baseColor = vec4(mix(intactAlbedo, charAlbedo, smoothstep(0.15, 0.85, charr)), alpha);
        material.metallic = mix(0.72, 0.02, charr);
        material.roughness = mix(0.28, 0.94, charr);

        vec3 emissive = edgeCol * glow * 1.65 +
                        vec3(1.0, 0.28, 0.03) * emberCracks * 0.85 +
                        vec3(1.0, 0.78, 0.32) * spark * 2.2;
        material.emissive = vec4(emissive, 0.0);
    }
}
