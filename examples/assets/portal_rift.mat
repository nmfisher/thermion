material {
    name : PortalRift,
    shadingModel : unlit,
    requires : [ position ],
    variables : [ objectPos ],
    parameters : [ { type : float, name : time }, { type : float, name : openAmount } ],
    blending : transparent,
    depthWrite : false,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}
vertex { void materialVertex(inout MaterialVertexInputs material){material.objectPos.xyz=getPosition().xyz;} }
fragment {
    float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
    float noise2(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x),f.y);}
    float fbm(vec2 p){float v=.0;v+=.5*noise2(p);p=p*2.03+3.1;v+=.25*noise2(p);p=p*2.01+7.7;v+=.125*noise2(p);return v/.875;}
    void material(inout MaterialInputs material){
        prepareMaterial(material);
        float opening = smoothstep(0.0, 1.0, clamp(materialParams.openAmount, 0.0, 1.0));
        vec2 p = variable_objectPos.xz * 2.0;
        p.x /= max(opening, 0.001);
        float r = length(p), t = materialParams.time;
        // Cartesian swirl is continuous across the polar seam. Its speed
        // increases toward the throat, giving the flow a sense of depth.
        float angle = t * 0.55 + 3.8 * exp(-r * 1.8);
        mat2 turn = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
        // Radial advection draws matter inward rather than only rotating
        // the texture in place. The circular opening remains stationary.
        vec2 flow = turn * p * (1.0 + .08*sin(t*.65-r*4.0));
        vec2 warp = vec2(fbm(flow * 3.8 + t * 0.12),
                         fbm(flow * 3.8 + 19.0 - t * 0.09));
        float cloud = fbm(flow * 7.0 + warp * 3.2);
        float filament = pow(1.0 - abs(2.0 * cloud - 1.0), 12.0);
        float throat = smoothstep(0.06, 0.65, r);
        float interior = 1.0 - smoothstep(0.78, 0.94, r);
        // An irregular narrow hot edge, with a separate soft corona, avoids
        // the thick plastic torus produced by the old radial band.
        float edgeNoise = fbm(p * 9.0 + warp * 1.8 - t * 0.18);
        float edge = r - (0.88 + (edgeNoise - 0.5) * 0.075);
        float aa = max(fwidth(edge), 0.001);
        float hot = 1.0 - smoothstep(0.004, 0.013 + aa, abs(edge));
        float halo = exp(-abs(edge) * 27.0);
        vec3 nebula = mix(vec3(0.008, 0.025, 0.12), vec3(0.13, 0.012, 0.22), warp.x);
        vec3 color = vec3(0.001, 0.002, 0.008) +
                     nebula * (0.18 + cloud * 0.8 + filament * 1.5) * throat * interior;
        vec3 rimColor = mix(vec3(0.035, 0.28, 0.95), vec3(0.42, 0.035, 0.8), warp.y);
        color += rimColor * halo * (0.3 + edgeNoise * 0.8);
        color += vec3(0.38, 0.72, 1.0) * hot * (0.45 + cloud * 0.55);
        // Smooth point sprites: stable seeds, no square cells or crawling
        // random thresholds. These orbit with the surrounding flow.
        vec2 starUV = flow * 34.0;
        vec2 cell = floor(starUV);
        vec2 starCenter = vec2(hash(cell), hash(cell + 27.0)) * 0.6 + 0.2;
        float starRadius = length(fract(starUV) - starCenter);
        float starAA = length(fwidth(starUV));
        float star = (1.0 - smoothstep(0.02, 0.10 + starAA, starRadius)) *
                     step(0.975, hash(cell + 71.0)) / (1.0 + starAA*starAA*40.0);
        color += vec3(0.5, 0.75, 1.0) * star * throat * interior * 0.35;
        float alpha = (1.0 - smoothstep(0.96, 1.04, r)) * smoothstep(0.0, 0.06, opening);
        material.baseColor = vec4(color * alpha, alpha);
    }
}
