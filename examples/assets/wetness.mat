material {
    name : Wetness,
    shadingModel : unlit,
    requires : [ position ],
    variables : [ worldPos ],
    parameters : [
        { type : float, name : time },
        { type : float, name : rainAmount }
    ],
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // The ground is an identity-transform plane in the showcase.
        material.worldPos.xyz = getPosition().xyz;
    }
}

fragment {
    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise2(vec2 p) {
        vec2 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i), hash(i + vec2(1,0)), f.x),
                   mix(hash(i + vec2(0,1)), hash(i + vec2(1,1)), f.x), f.y);
    }
    float fbm(vec2 p) {
        float v = 0.0;
        v += noise2(p) * .52; p = p * 2.03 + 7.1;
        v += noise2(p) * .27; p = p * 2.01 + 3.7;
        v += noise2(p) * .14; p *= 2.0;
        v += noise2(p) * .07;
        return v;
    }
    vec2 dropSlope(vec2 p, float t, float seed) {
        vec2 cell = floor(p), slope = vec2(0.0);
        // Neighbor cells let expanding waves cross cell boundaries intact.
        // Return the height gradient: rain perturbs reflection, not emission.
        float footprint = max(length(fwidth(p)), .001);
        for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
            vec2 id = cell + vec2(float(x), float(y));
            vec2 center = id + .2 + .6 * vec2(hash(id + seed), hash(id + seed + 17.3));
            float age = fract(t * (.42 + hash(id + 9.2) * .22) + hash(id + seed * 2.0));
            vec2 delta = p - center;
            float d = length(delta), front = d - age * .55;
            float envelope = exp(-front * front * 180.0) *
                             smoothstep(.0, .08, age) * (1.0 - smoothstep(.35, 1.0, age));
            float wave = cos(front * 65.0) * envelope;
            slope += delta / max(d, .001) * wave * step(.62, hash(id + 41.0)) *
                     (1.0 - smoothstep(.025, .12, footprint));
        }
        return slope;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 p = variable_worldPos.xz;
        float macro = fbm(p * .34 + 8.0);
        float puddle = smoothstep(.48, .61, macro + .08 * noise2(p * 2.7));
        vec2 rain = dropSlope(p * 1.9, materialParams.time, 1.0)
                  + dropSlope(p * 2.8 + 4.2, materialParams.time * 1.17, 5.0) * .55;
        float grit = noise2(p * 22.0) * noise2(p * 8.0 + 3.0);
        vec3 dry = mix(vec3(.008, .010, .013), vec3(.022, .018, .013), grit);
        float gritSlope = noise2(p*22.0+vec2(.12,.08))-noise2(p*22.0-vec2(.12,.08));
        dry *= .8 + clamp(gritSlope*2.0,-.3,.3);
        vec3 wet = mix(vec3(.0025, .004, .006), vec3(.008, .018, .024), macro);
        vec3 v = getWorldViewVector();
        float pooled = puddle * clamp(materialParams.rainAmount, 0.0, 1.0);
        vec3 n = normalize(vec3(rain.x * .13 * pooled, 1.0, rain.y * .13 * pooled));
        float grazing = .02 + .98 * pow(1.0 - max(dot(n, v), 0.0), 5.0);
        vec3 reflected = reflect(-v, n);
        float streak = pow(max(dot(reflected, normalize(vec3(-.55, .35, -.76))), 0.0), 85.0);
        vec3 color = mix(dry, wet, pooled);
        vec3 sky = mix(vec3(.025,.055,.095), vec3(.10,.18,.25), smoothstep(-.1,.8,reflected.y));
        color = mix(color, sky, pooled * grazing);
        color += vec3(.42,.55,.68) * streak * pooled * (.08 + grazing);
        float micro = pow(noise2(p * 31.0), 16.0);
        color += vec3(.34, .5, .62) * micro * pooled * grazing * .045;
        material.baseColor = vec4(color, 1.0);
    }
}
