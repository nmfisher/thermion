material {
    name : Electricity,
    shadingModel : unlit,
    requires : [ position ],
    variables : [ capsule, discharge ],
    parameters : [ { type : float, name : time }, { type : float, name : segmentCount } ],
    blending : add,
    depthWrite : false,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    float hash(float x) { return fract(sin(x * 127.1 + 311.7) * 43758.5453); }

    // Piecewise-linear fractal leaders: angular at several scales, with
    // no sinusoidal backbone and no disconnected per-segment jitter.
    float jagged(float u, float seed) {
        float value = 0.0, frequency = 3.0, amplitude = 0.65;
        for (int i = 0; i < 4; i++) {
            float x = u * frequency;
            float a = hash(floor(x) + seed + float(i) * 37.0);
            float b = hash(floor(x) + 1.0 + seed + float(i) * 37.0);
            value += (mix(a, b, fract(x)) - 0.5) * amplitude;
            frequency *= 2.3;
            amplitude *= 0.48;
        }
        return value;
    }
    vec2 trunk(float u, float seed) {
        float envelope = pow(max(sin(u * 3.14159265), 0.0), 0.65);
        return vec2(jagged(u, seed) * envelope, (0.5 - u) * 2.8);
    }
    float rootAt(float branch) {
        // Attach exactly to a trunk vertex.
        return floor((0.14 + branch * 0.12) * 48.0) / 48.0;
    }
    vec2 forkPath(float u, float branch, float seed) {
        float side = mod(branch, 2.0) < 0.5 ? -1.0 : 1.0;
        float reach = 0.35 + hash(branch + seed + 11.0) * 0.42;
        vec2 direction = vec2(side * reach, -0.3 - hash(branch + 7.0) * 0.4);
        vec2 perpendicular = normalize(vec2(-direction.y, direction.x));
        float bend = jagged(u, seed + branch * 19.0 + 53.0) -
                     jagged(0.0, seed + branch * 19.0 + 53.0);
        return trunk(rootAt(branch), seed) + direction * u + perpendicular * bend * u * 0.65;
    }
    vec2 twigPath(float u, float branch, float seed) {
        float side = mod(branch, 2.0) < 0.5 ? 1.0 : -1.0;
        float bend = jagged(u, seed + branch * 23.0 + 97.0) -
                     jagged(0.0, seed + branch * 23.0 + 97.0);
        return forkPath(0.5, branch, seed) +
               vec2(side * (u * 0.22 + bend * u * 0.4), -u * 0.32);
    }
    vec2 pathPoint(float u, float branch, float tier, float seed) {
        if (tier < 0.5) return trunk(u, seed);
        if (tier < 1.5) return forkPath(u, branch, seed);
        return twigPath(u, branch, seed);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int vi = getVertexIndex(), corner = vi % 6;
        float id = float(vi / 6);
        vec2 uv = vec2(corner == 1 || corner == 2 || corner == 4 ? 1.0 : 0.0,
                       corner == 2 || corner == 3 || corner == 4 ? 1.0 : 0.0);
        // 48 trunk segments + six 16-segment forks + six 8-segment twigs.
        float tier = id < 48.0 ? 0.0 : (id < 144.0 ? 1.0 : 2.0);
        float count = tier < 0.5 ? 48.0 : (tier < 1.5 ? 16.0 : 8.0);
        float localId = tier < 0.5 ? id : (tier < 1.5 ? id - 48.0 : id - 144.0);
        float branch = floor(localId / count), segment = mod(localId, count);
        float u0 = segment / count, u1 = (segment + 1.0) / count;
        // Keep the channel stable for the initial strike and return strokes.
        // New topology appears only after the previous discharge fades.
        float cycle = floor(materialParams.time / 0.9);
        float age = mod(materialParams.time, 0.9), seed = cycle * 71.0 + 3.7;
        vec2 a = pathPoint(u0, branch, tier, seed);
        vec2 b = pathPoint(u1, branch, tier, seed);
        vec2 delta = b - a;
        float len = max(length(delta), 0.0001);
        vec2 tangent = delta / len, side = vec2(-tangent.y, tangent.x);
        float radius = tier < 0.5 ? 0.048 : (tier < 1.5 ? 0.027 : 0.018);
        float along = mix(-radius, len + radius, uv.y);
        vec2 point = a + tangent * along + side * (uv.x * 2.0 - 1.0) * radius;
        material.worldPosition.xyz += vec3(point, 0.0) - getPosition().xyz;
        material.capsule = vec4((uv.x * 2.0 - 1.0) * radius, along, len, radius);
        float progress = tier < 0.5 ? u0 : rootAt(branch) + u0 * 0.25 + (tier - 1.0) * 0.14;
        float arrival = progress * 0.065, localAge = max(age - arrival, 0.0);
        float pulse = exp(-localAge * 17.0) +
                      0.72 * exp(-max(localAge - 0.12, 0.0) * 28.0) * step(0.12, localAge) +
                      0.42 * exp(-max(localAge - 0.26, 0.0) * 23.0) * step(0.26, localAge);
        pulse *= smoothstep(0.0, 0.007, age - arrival);
        float taper = tier < 0.5 ? 1.0 : mix(1.0, 0.12, u0);
        float power = tier < 0.5 ? 1.0 : (tier < 1.5 ? 0.65 : 0.35);
        float enabled = 1.0 - step(materialParams.segmentCount, id);
        material.discharge = vec4(mix(0.0034, 0.0018, tier * 0.5) * sqrt(taper),
                                  pulse * power * sqrt(taper) * enabled, tier, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Rounded caps overlap at shared endpoints, avoiding square joints.
        vec4 p = variable_capsule;
        float endDistance = max(max(-p.y, p.y - p.z), 0.0);
        float d = length(vec2(p.x, endDistance));
        float aa = max(fwidth(d), 0.0002), width = variable_discharge.x;
        float core = 1.0 - smoothstep(max(width - aa, 0.0), width + aa, d);
        core *= min(1.0, width / aa);
        float sheath = exp(-d / max(width * 3.0, 0.002));
        float halo = exp(-d * d / (p.w * p.w * 0.22));
        float edge = 1.0 - smoothstep(p.w * 0.65, p.w, d);
        vec3 color = vec3(0.64, 0.82, 1.0) * core * 1.2 +
                     vec3(0.10, 0.28, 1.0) * sheath * 0.12 +
                     vec3(0.045, 0.07, 0.45) * halo * 0.04;
        material.baseColor = vec4(color * variable_discharge.y * edge, 1.0);
    }
}
