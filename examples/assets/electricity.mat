material {
    name : Electricity,
    shadingModel : unlit,
    requires : [ position ],
    variables : [ capsule, discharge ],
    parameters : [ { type : float, name : time }, { type : float, name : segmentCount } ],
    blending : add,
    depthWrite : false,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    float hash(float x) { return fract(sin(x * 127.1 + 311.7) * 43758.5453); }

    // Piecewise-linear 6-octave fractal leaders: crisp angular micro-kinks at
    // every scale with zero smooth sinusoidal wave artifacts.
    float jagged(float u, float seed) {
        float value = 0.0, frequency = 3.2, amplitude = 0.62;
        for (int i = 0; i < 6; i++) {
            float x = u * frequency;
            float a = hash(floor(x) + seed + float(i) * 37.0);
            float b = hash(floor(x) + 1.0 + seed + float(i) * 37.0);
            value += (mix(a, b, fract(x)) - 0.5) * amplitude;
            frequency *= 2.35;
            amplitude *= 0.49;
        }
        return value;
    }
    vec2 trunk(float u, float seed) {
        float envelope = pow(max(sin(u * 3.14159265), 0.0), 0.65);
        return vec2(jagged(u, seed) * envelope, (0.5 - u) * 2.8);
    }
    float rootAt(float branch) {
        // Attach exactly to a trunk vertex.
        return floor((0.14 + branch * 0.12) * 48.0) / 48.0;
    }
    vec2 forkPath(float u, float branch, float seed) {
        float side = mod(branch, 2.0) < 0.5 ? -1.0 : 1.0;
        float reach = 0.35 + hash(branch + seed + 11.0) * 0.42;
        vec2 direction = vec2(side * reach, -0.3 - hash(branch + 7.0) * 0.4);
        vec2 perpendicular = normalize(vec2(-direction.y, direction.x));
        float bend = jagged(u, seed + branch * 19.0 + 53.0) -
                     jagged(0.0, seed + branch * 19.0 + 53.0);
        return trunk(rootAt(branch), seed) + direction * u + perpendicular * bend * u * 0.65;
    }
    vec2 twigPath(float u, float branch, float seed) {
        float side = mod(branch, 2.0) < 0.5 ? 1.0 : -1.0;
        float bend = jagged(u, seed + branch * 23.0 + 97.0) -
                     jagged(0.0, seed + branch * 23.0 + 97.0);
        return forkPath(0.5, branch, seed) +
               vec2(side * (u * 0.22 + bend * u * 0.4), -u * 0.32);
    }
    vec2 pathPoint(float u, float branch, float tier, float seed) {
        if (tier < 0.5) return trunk(u, seed);
        if (tier < 1.5) return forkPath(u, branch, seed);
        return twigPath(u, branch, seed);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        int vi = getVertexIndex(), corner = vi % 6;
        float id = float(vi / 6);
        vec2 uv = vec2(corner == 1 || corner == 2 || corner == 4 ? 1.0 : 0.0,
                       corner == 2 || corner == 3 || corner == 4 ? 1.0 : 0.0);
        // 48 trunk segments + six 16-segment forks + six 8-segment twigs.
        float tier = id < 48.0 ? 0.0 : (id < 144.0 ? 1.0 : 2.0);
        float count = tier < 0.5 ? 48.0 : (tier < 1.5 ? 16.0 : 8.0);
        float localId = tier < 0.5 ? id : (tier < 1.5 ? id - 48.0 : id - 144.0);
        float branch = floor(localId / count), segment = mod(localId, count);
        float u0 = segment / count, u1 = (segment + 1.0) / count;
        // Sustained high-voltage snapping discharge: re-strikes along a fresh
        // fractal leader topology ~3.6 times/sec with subtle thermal plasma quiver
        // while active, return-stroke surges, and brief micro-extinctions.
        float tShift = materialParams.time + 0.09;
        float period = 0.28;
        float cycle = floor(tShift / period);
        float age = mod(tShift, period), seed = cycle * 71.0 + 3.7;
        vec2 a = pathPoint(u0, branch, tier, seed);
        vec2 b = pathPoint(u1, branch, tier, seed);
        // Subtle convective lateral quiver of the ionized plasma channel.
        float quiverA = sin(u0 * 19.0 + tShift * 38.0 + seed) * 0.014 * sin(u0 * 3.14159265);
        float quiverB = sin(u1 * 19.0 + tShift * 38.0 + seed) * 0.014 * sin(u1 * 3.14159265);
        a.x += quiverA;
        b.x += quiverB;
        vec2 delta = b - a;
        float len = max(length(delta), 0.0001);
        vec2 tangent = delta / len, side = vec2(-tangent.y, tangent.x);
        float radius = tier < 0.5 ? 0.14 : (tier < 1.5 ? 0.075 : 0.045);
        float along = mix(-radius, len + radius, uv.y);
        vec2 point = a + tangent * along + side * (uv.x * 2.0 - 1.0) * radius;
        material.worldPosition.xyz += vec3(point, 0.0) - getPosition().xyz;
        material.capsule = vec4((uv.x * 2.0 - 1.0) * radius, along, len, radius);
        float progress = tier < 0.5 ? u0 : rootAt(branch) + u0 * 0.25 + (tier - 1.0) * 0.14;
        float arrival = progress * 0.032, localAge = max(age - arrival, 0.0);
        float surge = mod(cycle, 3.0) < 0.5 ? 1.28 : 0.92;
        float flicker = 0.80 + 0.20 * sin(tShift * 89.0 + branch * 3.1);
        float sustain = tier < 0.5 ? 0.42 : (tier < 1.5 ? 0.22 : 0.10);
        float pulse = (sustain * flicker +
                       0.82 * exp(-localAge * 16.0) +
                       0.52 * exp(-max(localAge - 0.11, 0.0) * 28.0) * step(0.11, localAge)) * surge;
        pulse *= smoothstep(0.0, 0.006, age - arrival) *
                 mix(0.24, 1.0, 1.0 - smoothstep(0.235, 0.278, age));
        float taper = tier < 0.5 ? 1.0 : mix(1.0, 0.14, u0);
        float power = tier < 0.5 ? 1.0 : (tier < 1.5 ? 0.62 : 0.34);
        float enabled = 1.0 - step(materialParams.segmentCount, id);
        // Razor-thin plasma core width so overlapping fork joints never bloat into sausages.
        float uInterp = mix(u0, u1, clamp(along / len, 0.0, 1.0));
        material.discharge = vec4(mix(0.0036, 0.0014, tier * 0.5) * sqrt(taper),
                                  pulse * power * sqrt(taper) * enabled, tier, uInterp);
    }
}

fragment {
    float fragHash(float x) { return fract(sin(x * 91.7 + 17.3) * 43758.5453); }
    float subArcOffset(float u, float t) {
        float x = u * 26.0 - t * 14.0;
        float i = floor(x), f = fract(x);
        float a = fragHash(i) - 0.5, b = fragHash(i + 1.0) - 0.5;
        return mix(a, b, f) * 0.022 * sin(u * 3.14159265);
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 p = variable_capsule;
        float endDistance = max(max(-p.y, p.y - p.z), 0.0);
        float d = length(vec2(p.x, endDistance));
        float aa = max(fwidth(d), 0.0003), width = variable_discharge.x;

        // Needle-sharp incandescent core + delicate intertwined secondary plasma thread
        // on the main trunk, surrounded by a restrained electric-blue/violet corona.
        float core = 1.0 - smoothstep(max(width - aa, 0.0), width + aa, d);
        core *= min(1.0, width / aa);

        float secOff = subArcOffset(variable_discharge.w, materialParams.time);
        float dSec = length(vec2(p.x - secOff, endDistance));
        float secMask = (1.0 - step(0.5, variable_discharge.z)) * smoothstep(p.w, 0.0, abs(secOff) * 2.0);
        float subCore = (1.0 - smoothstep(width * 0.45, width * 0.45 + aa, dSec)) * secMask;
        float subSheath = exp(-dSec / max(width * 2.6, 0.002)) * secMask;

        float innerSheath = exp(-d / max(width * 3.0, 0.0025));
        float outerCorona = exp(-d * d / max(p.w * p.w * 0.16, 0.0002));
        float edge = 1.0 - smoothstep(p.w * 0.55, p.w, d);

        // Anchor electrode flare at the top/bottom strike points of the main trunk.
        float u = variable_discharge.w;
        float anchor = (exp(-u * 52.0) + exp(-(1.0 - u) * 52.0)) *
                       (1.0 - step(0.5, variable_discharge.z)) *
                       exp(-d * d / 0.0009);

        vec3 color = vec3(0.92, 0.97, 1.0) * (core * 1.65 + subCore * 0.65 + anchor * 0.42) +
                     vec3(0.24, 0.56, 1.0) * (innerSheath * 0.22 + subSheath * 0.11) +
                     vec3(0.08, 0.12, 0.58) * outerCorona * 0.026;
        material.baseColor = vec4(color * variable_discharge.y * edge, 1.0);
    }
}
