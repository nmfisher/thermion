material {
    name : ImpactGround, shadingModel : lit,
    requires : [ position, tangents ], variables : [ objectPos ],
    parameters : [ { type : float, name : age }, { type : float, name : strength } ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs m) {
        vec3 p=getPosition().xyz;
        float r=length(p.xz);
        float h=(-.28*exp(-r*r*2.2)+.16*exp(-pow((r-1.0)/.23,2.0)))*materialParams.strength;
        m.worldPosition.y+=h;
        float slope=(1.232*r*exp(-r*r*2.2)-.32*(r-1.0)/(.23*.23)*
                     exp(-pow((r-1.0)/.23,2.0)))*materialParams.strength;
        m.worldNormal=normalize(vec3(-slope*p.x/max(r,.001),1.0,-slope*p.z/max(r,.001)));
        m.objectPos.xyz=p+vec3(0,h,0);
    }
}
fragment {

    float hash(highp vec2 p) {
        highp vec3 q=fract(vec3(p.xyx)*.1031); q+=dot(q,q.yzx+33.33);
        return fract((q.x+q.y)*q.z);
    }
    float noise(vec2 p) {
        vec2 i=floor(p),f=fract(p); f=f*f*(3.0-2.0*f);
        return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),
                   mix(hash(i+vec2(0,1)),hash(i+1.0),f.x),f.y);
    }

    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec2 p=variable_objectPos.xz;
        float r=length(p),a=atan(p.y,p.x+.00001);
        float n=noise(p*8.0);
        float scar=(1.0-smoothstep(1.0,2.0,r+(n-.5)*.45))*materialParams.strength;
        float fissure=pow(max(0.0,cos(a*17.0+noise(p*3.0)*2.5)),28.0);
        fissure*=smoothstep(.25,.55,noise(p*11.0));
        fissure*=smoothstep(.3,.6,r)*(1.0-smoothstep(1.2,1.7,r));
        float rim=exp(-pow((r-.98-(n-.5)*.12)/.055,2.0));
        float heat=exp(-max(0.0,materialParams.age)*.75)*materialParams.strength;
        m.baseColor=vec4(mix(vec3(.022,.025,.03),vec3(.012,.008,.006)*(.8+n*.3),scar),1);
        m.roughness=.9; m.metallic=0.0;
        m.emissive=vec4(vec3(.7,.08,.006)*(fissure*.38+rim*.25)*heat,0);
    }
}
