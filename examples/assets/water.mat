material {
    name : Water,
    requires : [ position, tangents ],
    variables : [
        surfaceNormal,
        surfacePos
    ],
    parameters : [
        { type : float4, name : deepColor },
        { type : float4, name : skyColor },
        { type : float4, name : foamColor },
        { type : float3, name : sunDirection },
        { type : float,  name : time },
        { type : float,  name : waveHeight },
        { type : float,  name : waveFrequency },
        { type : float,  name : waveSpeed },
        { type : float,  name : foamAmount },
        { type : float,  name : specularPower },
        { type : float,  name : specularIntensity }
    ],
    depthWrite : true,
    depthCulling : true,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    // Sum of three Gerstner waves displaced from a flat XZ grid.
    vec3 gerstner(vec2 p, vec2 dir, float freq, float speed, float amp) {
        float phase = dot(dir, p) * freq - materialParams.time * speed;
        float s = sin(phase);
        float c = cos(phase);
        float q = 0.6; // steepness: horizontal choppiness
        return vec3(q * amp * dir.x * c, amp * s, q * amp * dir.y * c);
    }

    vec3 waveSum(vec2 p) {
        float h = materialParams.waveHeight;
        vec3 w = gerstner(p, normalize(vec2(1.0, 0.35)),
                          materialParams.waveFrequency,
                          materialParams.waveSpeed, h);
        w += gerstner(p, normalize(vec2(-0.6, 1.0)),
                          materialParams.waveFrequency * 2.1,
                          materialParams.waveSpeed * 1.4, h * 0.5);
        w += gerstner(p, normalize(vec2(0.4, -0.9)),
                          materialParams.waveFrequency * 3.7,
                          materialParams.waveSpeed * 1.9, h * 0.25);
        return w;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        vec3 world = material.worldPosition.xyz;
        vec3 disp = waveSum(world.xz);
        material.worldPosition.xyz = world + disp;

        // Finite-difference normal from the full displaced surface.
        // Surface(x,z) = (x,0,z) + waveSum(x,z); cross(Sz, Sx) points up.
        float eps = 0.08;
        vec3 dispX = waveSum(world.xz + vec2(eps, 0.0)) - disp;
        vec3 dispZ = waveSum(world.xz + vec2(0.0, eps)) - disp;
        vec3 sx = vec3(eps, 0.0, 0.0) + dispX;
        vec3 sz = vec3(0.0, 0.0, eps) + dispZ;
        material.surfaceNormal.xyz = normalize(cross(sz, sx));
        material.surfacePos.xyz = material.worldPosition.xyz;
    }
}

fragment {
    float hash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    float noise2(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
                   mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
    }

    float fbm(vec2 p) {
        float v = 0.0;
        v += 0.5 * noise2(p);  p *= 2.03;
        v += 0.25 * noise2(p); p *= 2.01;
        v += 0.125 * noise2(p);
        return v / 0.875;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 pos = variable_surfacePos.xyz;
        vec3 n = normalize(variable_surfaceNormal.xyz);
        vec3 viewDir = normalize(getWorldCameraPosition() - pos);
        vec3 sun = normalize(-materialParams.sunDirection);

        // Fresnel: looking down sees deep water, grazing angles reflect sky.
        float fresnel = pow(1.0 - max(dot(n, viewDir), 0.0), 3.0);

        vec3 color = mix(materialParams.deepColor.rgb,
                         materialParams.skyColor.rgb, fresnel);

        // Sun glint (Blinn-Phong).
        vec3 halfDir = normalize(viewDir + sun);
        float spec = pow(max(dot(n, halfDir), 0.0),
                         materialParams.specularPower);
        color += vec3(1.0, 0.95, 0.85) * spec * materialParams.specularIntensity;

        // Foam on wave crests, broken up by drifting noise.
        float h = materialParams.waveHeight;
        float crest = clamp(pos.y / (h + 0.001), 0.0, 1.0);
        float foamNoise = fbm(pos.xz * 2.5 + materialParams.time * 0.15);
        float foam = smoothstep(1.0 - materialParams.foamAmount, 1.0,
                                crest * (0.6 + 0.8 * foamNoise));
        color = mix(color, materialParams.foamColor.rgb, foam * 0.85);

        // Opaque when reflecting, translucent when looking through.
        float alpha = clamp(0.75 + 0.25 * fresnel, 0.0, 1.0) *
                      materialParams.deepColor.a;
        alpha = max(alpha, foam);

        material.baseColor = vec4(color, alpha);
    }
}
