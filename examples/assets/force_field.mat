material {
    name : ForceField,
    requires : [ position, tangents ],
    variables : [
        surfaceNormal,
        worldPos
    ],
    parameters : [
        { type : float4, name : baseColor },
        { type : float,  name : time },
        { type : float,  name : fresnelPower },
        { type : float,  name : hexScale },
        { type : float,  name : hexStrength },
        { type : float3, name : hitDirection },
        { type : float,  name : hitAge }
    ],
    depthWrite : false,
    depthCulling : false,
    shadingModel : unlit,
    blending : add,
    culling : back,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

fragment {
    // Returns (edgeDist, cellHash, cellCenter.x, cellCenter.y) for 2D hex grid.
    vec4 hexTile(vec2 p) {
        const vec2 s = vec2(1.0, 1.7320508);
        vec2 h = s * 0.5;
        vec2 a = mod(p, s) - h;
        vec2 b = mod(p - h, s) - h;
        vec2 gv = dot(a, a) < dot(b, b) ? a : b;
        vec2 id = p - gv;
        float ed = 0.5 - max(dot(abs(gv), normalize(s)), abs(gv.x));
        float cellHash = fract(sin(dot(floor(id * 2.0 + 0.5), vec2(127.1, 311.7))) * 43758.5453);
        return vec4(ed, cellHash, id.x, id.y);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 normal = normalize(variable_surfaceNormal.xyz);
        vec3 viewDir = getWorldViewVector();
        float t = materialParams.time;

        // Glassy-clear center so the inner core is crisp; sharp Fresnel rim at silhouette.
        float ndv = abs(dot(normal, viewDir));
        float fresnel = pow(1.0 - ndv, materialParams.fresnelPower + 0.8);
        float rimLip = pow(1.0 - ndv, 9.0);
        float rimGlow = pow(1.0 - ndv, 3.8);

        // Dominant-axis triplanar hex tiles so each hexagonal armor cell has a
        // coherent 3D cell center for quantized shockwave tile activation!
        float hexScale = max(2.0, materialParams.hexScale * 0.45);
        vec3 w = pow(abs(normal), vec3(8.0));
        w /= max(w.x + w.y + w.z, 0.0001);
        vec4 hx = hexTile(normal.yz * hexScale);
        vec4 hy = hexTile(normal.xz * hexScale);
        vec4 hz = hexTile(normal.xy * hexScale);
        float edgeDist = hx.x * w.x + hy.x * w.y + hz.x * w.z;
        float cellSeed = hx.y * w.x + hy.y * w.y + hz.y * w.z;

        // Approximate quantized cell-center direction on the unit sphere.
        vec3 cellN = abs(normal.x) > max(abs(normal.y), abs(normal.z))
            ? normalize(vec3(sign(normal.x) * sqrt(max(1.0 - dot(hx.zw / hexScale, hx.zw / hexScale), 0.05)), hx.zw / hexScale))
            : (abs(normal.y) > abs(normal.z)
                ? normalize(vec3(hy.z / hexScale, sign(normal.y) * sqrt(max(1.0 - dot(hy.zw / hexScale, hy.zw / hexScale), 0.05)), hy.w / hexScale))
                : normalize(vec3(hz.zw / hexScale, sign(normal.z) * sqrt(max(1.0 - dot(hz.zw / hexScale, hz.zw / hexScale), 0.05)))));

        float aa = max(fwidth(edgeDist), 0.003);
        float hexLine = 1.0 - smoothstep(0.016, 0.036 + aa, edgeDist);
        float hexBevel = smoothstep(0.02, 0.075, edgeDist) * (1.0 - smoothstep(0.075, 0.22, edgeDist));
        float hexPlate = smoothstep(0.035, 0.09, edgeDist);

        // Idle shield: ultra-subtle at normal incidence, revealing crisp hex lines only near rim.
        float flow = 0.5 + 0.5 * sin(normal.y * 9.0 - t * 2.8 + cellSeed * 3.14);
        float idleLattice = hexLine * (0.06 + 0.88 * rimGlow) * (0.65 + 0.35 * flow) * materialParams.hexStrength;

        // --- impact shockwave + quantized hex armor-tile response ---------
        vec3 hitDir = normalize(materialParams.hitDirection);
        float ang = acos(clamp(dot(normal, hitDir), -1.0, 1.0));
        float cellAng = acos(clamp(dot(cellN, hitDir), -1.0, 1.0));
        float age = materialParams.hitAge;

        // Hot focal point at impact site.
        float da = ang * 11.0;
        float splash = exp(-da * da) * exp(-age * 6.5) * 2.4;

        // Chromatic plasma shockwave front (sharp leading edge, trailing wake).
        float ringR = age * 1.9;
        float drLead = (ang - ringR) * 24.0;
        float drTrail = (ang - (ringR - 0.065)) * 15.0;
        float leadWave = exp(-drLead * drLead) * exp(-age * 1.05);
        float trailWave = exp(-drTrail * drTrail) * exp(-age * 1.15);

        // Individual hex plates ignite with slight per-cell jitter when the wave reaches their center!
        float dCell = (cellAng - ringR + (cellSeed - 0.5) * 0.055) * 11.5;
        float tileFlash = exp(-dCell * dCell) * exp(-age * 1.1) * (0.45 + 0.55 * step(0.28, cellSeed));
        float tileFill = tileFlash * hexPlate * (0.45 + 0.55 * hexBevel * 2.0);
        float tileBorder = (leadWave + tileFlash * 0.85) * hexLine * 2.6 * materialParams.hexStrength;

        // Crackling radial plasma filaments along the shock front.
        vec3 reference = abs(hitDir.y) > 0.95 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 ringU = normalize(cross(hitDir, reference));
        vec3 ringV = cross(hitDir, ringU);
        float ringAngle = atan(dot(normal, ringV), dot(normal, ringU));
        float sparks = leadWave * pow(max(sin(ringAngle * 13.0 - t * 9.0), 0.0), 14.0) * 1.8;

        vec3 base = materialParams.baseColor.rgb;
        vec3 cyanHot = vec3(0.62, 0.96, 1.0);
        vec3 violetWake = mix(base, vec3(0.48, 0.22, 1.0), 0.68);

        vec3 rgb = base * (0.008 + fresnel * 0.52 + idleLattice * 0.85) +
                   mix(base, cyanHot, 0.65) * rimLip * 1.65 +
                   cyanHot * (splash + leadWave * 1.15 + tileBorder * 0.85 + sparks) +
                   mix(base * 1.25, cyanHot, 0.35) * tileFill * 1.15 +
                   violetWake * trailWave * 0.95;

        material.baseColor = vec4(rgb * 0.014, 1.0);
    }
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.surfaceNormal.xyz = material.worldNormal;
        // material.worldPosition is pre-transform on this pipeline; build
        // true world position from the model matrix.
        material.worldPos.xyz = (getWorldFromModelMatrix() *
                                 vec4(getPosition().xyz, 1.0)).xyz;
    }
}
