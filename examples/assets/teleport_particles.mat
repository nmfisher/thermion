material {
    name : TeleportParticles, shadingModel : unlit,
    requires : [ position ], variables : [ particle ],
    parameters : [ { type : float, name : travel } ],
    blending : add, depthWrite : false, culling : none
}
vertex {
    vec3 streamPos(vec3 local, float u, float id, float seed) {
        float arc = sin(u * 3.14159265);
        float angle = id * 2.39996 + u * 8.5;
        float swirlR = (0.12 + 0.24 * seed) * arc;
        vec3 center = local + vec3(mix(-1.45, 1.45, smoothstep(0.0, 1.0, u)), 0.0, 0.0);
        center += vec3(0.06 * sin(angle), 0.72 * arc + cos(angle) * swirlR * 0.5, sin(angle) * swirlR);
        return center;
    }
    void materialVertex(inout MaterialVertexInputs m) {
        int vid = getVertexIndex(), i = vid / 6, k = vid - i * 6;
        vec2 corners[6] = vec2[6](vec2(-1,-1), vec2(1,-1), vec2(-1,1),
                                  vec2(1,-1), vec2(1,1), vec2(-1,1));
        highp float fi = float(i);
        highp float seed = fract(fi * .6180339887);
        vec3 local = getPosition().xyz;
        float delay = clamp((local.y - 0.15) / 1.6, 0.0, 1.0) * .26 + seed * .12;
        float u = clamp((materialParams.travel - delay) / .62, 0.0, 1.0);
        vec3 center = streamPos(local, u, fi, seed);
        vec3 ahead = streamPos(local, min(u + 0.025, 1.0), fi, seed);

        mat4 view = getViewFromWorldMatrix();
        vec3 camRight = vec3(view[0].x, view[1].x, view[2].x);
        vec3 camUp = vec3(view[0].y, view[1].y, view[2].y);
        vec3 camFwd = cross(camRight, camUp);

        // Velocity-aligned plasma ribbon streaks during transit, shrinking to sparks at endpoints!
        float speedFactor = sin(u * 3.14159265);
        vec3 vel = ahead - center;
        vec3 dir = length(vel) > 0.0001 ? normalize(vel) : camRight;
        vec3 perp = normalize(cross(dir, camFwd) + camUp * 0.001);

        float len = (.010 + .065 * speedFactor) * (.55 + .65 * seed);
        float thick = (.0045 + .0065 * seed) * (1.0 - 0.25 * speedFactor);
        vec2 c = corners[k];
        m.worldPosition.xyz += center - getPosition().xyz + dir * (c.x * len) + perp * (c.y * thick);
        float vis = smoothstep(0.0, .06, u) * (1.0 - smoothstep(.92, 1.0, u));
        m.particle = vec4(c, vis, seed);
    }
}
fragment {
    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec2 p = variable_particle.xy;
        float r2 = dot(p, p);
        float core = exp(-r2 * 7.5);
        float halo = exp(-r2 * 2.2) * (1.0 - smoothstep(0.7, 1.0, sqrt(r2)));
        vec3 tint = mix(vec3(.06, .52, 1.0), vec3(.52, .24, 1.0), step(0.65, variable_particle.w));
        vec3 rgb = vec3(.78, .95, 1.0) * core * .22 + tint * halo * .14;
        m.baseColor = vec4(rgb * variable_particle.z, 1.0);
    }
}
