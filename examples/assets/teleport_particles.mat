material {
    name : TeleportParticles, shadingModel : unlit,
    requires : [ position ], variables : [ particle ],
    parameters : [ { type : float, name : travel } ],
    blending : add, depthWrite : false, culling : none
}
vertex {
    void materialVertex(inout MaterialVertexInputs m) {
        int vid=getVertexIndex(),i=vid/6,k=vid-i*6;
        vec2 corners[6]=vec2[6](vec2(-1,-1),vec2(1,-1),vec2(-1,1),
                               vec2(1,-1),vec2(1,1),vec2(-1,1));
        highp float seed=fract(float(i)*.6180339887);
        vec3 local=getPosition().xyz;
        float delay=local.y/2.3*.22+seed*.08;
        float u=clamp((materialParams.travel-delay)/.7,0.0,1.0);
        float arc=sin(u*3.141593);
        float angle=float(i)*2.39996+u*7.0;
        vec3 center=local+vec3(mix(-1.45,1.45,u),0,0);
        center+=vec3(.08*sin(angle),.65+cos(angle)*.4,sin(angle)*.55)*arc;
        mat4 view=getViewFromWorldMatrix();
        vec3 right=vec3(view[0].x,view[1].x,view[2].x);
        vec3 up=vec3(view[0].y,view[1].y,view[2].y);
        float size=.008+.013*seed;
        vec2 c=corners[k];
        m.worldPosition.xyz+=center-getPosition().xyz+(right*c.x+up*c.y)*size;
        m.particle=vec4(c,smoothstep(0.0,.08,u)*(1.0-smoothstep(.9,1.0,u)),seed);
    }
}
fragment {
    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec2 p=variable_particle.xy;
        float coverage=1.0-smoothstep(.25,1.0,length(p));
        vec3 tint=mix(vec3(.06,.4,.85),vec3(.45,.7,1),variable_particle.w);
        m.baseColor=vec4(tint*coverage*variable_particle.z*.35,0);
    }
}
