# Keep the cache layout and URI resolution in sync with
# thermion_dart/hook/build.dart and lib/src/hooks/filament_artifacts.dart.
# These paths must be available before flutter_assemble runs the hook that
# downloads the headers.
include_guard(GLOBAL)

# Converts a package_config.json rootUri (file:///C:/..., file:///path/...,
# file://server/share/..., or a relative URI) into a percent-decoded filesystem
# path without double-decoding escaped '%25' sequences.
function(thermion_decode_file_uri output uri)
  if(uri MATCHES "^file:///([A-Za-z]:.*)")
    set(_rem "${CMAKE_MATCH_1}")
  elseif(uri MATCHES "^file://(/.*)")
    set(_rem "${CMAKE_MATCH_1}")
  elseif(uri MATCHES "^file://(.+)")
    set(_rem "//${CMAKE_MATCH_1}")
  else()
    set(_rem "${uri}")
  endif()

  set(_decoded "")
  string(FIND "${_rem}" "%" _pos)
  while(NOT _pos EQUAL -1)
    string(SUBSTRING "${_rem}" 0 ${_pos} _prefix)
    string(APPEND _decoded "${_prefix}")
    string(LENGTH "${_rem}" _rem_len)
    math(EXPR _after_hex "${_pos} + 3")
    if(_after_hex LESS_EQUAL _rem_len)
      math(EXPR _hex_start "${_pos} + 1")
      string(SUBSTRING "${_rem}" ${_hex_start} 2 _hex)
      if(_hex MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]$")
        math(EXPR _code "0x${_hex}")
        if(_code GREATER 0)
          string(ASCII ${_code} _ch)
          string(APPEND _decoded "${_ch}")
          string(SUBSTRING "${_rem}" ${_after_hex} -1 _rem)
          string(FIND "${_rem}" "%" _pos)
          continue()
        endif()
      endif()
    endif()
    string(APPEND _decoded "%")
    math(EXPR _next "${_pos} + 1")
    string(SUBSTRING "${_rem}" ${_next} -1 _rem)
    string(FIND "${_rem}" "%" _pos)
  endwhile()
  string(APPEND _decoded "${_rem}")
  set(${output} "${_decoded}" PARENT_SCOPE)
endfunction()

# Resolves thermion_dart's package root from the consuming app's
# .dart_tool/package_config.json, falling back to the monorepo layout.
function(thermion_resolve_package_root output search_start plugin_dir)
  set(_pkg_config "")
  get_filename_component(_search_dir "${search_start}" ABSOLUTE)
  foreach(_i RANGE 1 15)
    if(EXISTS "${_search_dir}/.dart_tool/package_config.json")
      set(_pkg_config "${_search_dir}/.dart_tool/package_config.json")
      message(STATUS "thermion_flutter: found package_config at ${_pkg_config}")
      break()
    endif()
    get_filename_component(_search_dir "${_search_dir}" DIRECTORY)
  endforeach()

  set(_td_root "")
  if(_pkg_config)
    thermion_escape_for_generator(_pkg_config_dep "${_pkg_config}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pkg_config_dep}")
    file(READ "${_pkg_config}" _pkg_json)
    string(JSON _pkg_len ERROR_VARIABLE _json_err LENGTH "${_pkg_json}" packages)
    if(NOT _json_err AND _pkg_len GREATER 0)
      math(EXPR _pkg_end "${_pkg_len} - 1")
      set(_td_root_uri "")
      foreach(_idx RANGE 0 ${_pkg_end})
        string(JSON _pkg_name ERROR_VARIABLE _json_err GET "${_pkg_json}" packages ${_idx} name)
        if(_json_err)
          continue()
        endif()
        if(_pkg_name STREQUAL "thermion_dart")
          string(JSON _td_root_uri ERROR_VARIABLE _json_err GET "${_pkg_json}" packages ${_idx} rootUri)
          break()
        endif()
      endforeach()

      if(_td_root_uri)
        thermion_decode_file_uri(_td_root "${_td_root_uri}")
        if(NOT IS_ABSOLUTE "${_td_root}")
          get_filename_component(_pkg_dir "${_pkg_config}" DIRECTORY)
          get_filename_component(_td_root "${_td_root}" ABSOLUTE BASE_DIR "${_pkg_dir}")
        else()
          get_filename_component(_td_root "${_td_root}" ABSOLUTE)
        endif()
        if(NOT _td_root STREQUAL "/" AND NOT _td_root MATCHES "^[A-Za-z]:/$")
          string(REGEX REPLACE "/+$" "" _td_root "${_td_root}")
        endif()
        message(STATUS "thermion_flutter: resolved thermion_dart to ${_td_root}")
      endif()
    endif()
  endif()

  if(NOT _td_root)
    get_filename_component(_real_plugin_dir "${plugin_dir}" REALPATH)
    get_filename_component(_td_root "${_real_plugin_dir}/../../../thermion_dart" ABSOLUTE)
    if(NOT EXISTS "${_td_root}/native/include")
      set(_td_root "")
    else()
      message(STATUS "thermion_flutter: using monorepo fallback ${_td_root}")
    endif()
  endif()

  set(${output} "${_td_root}" PARENT_SCOPE)
endfunction()

function(thermion_linux_filament_platform output)
  if(FLUTTER_TARGET_PLATFORM STREQUAL "linux-arm64")
    set(${output} "linux-arm64" PARENT_SCOPE)
  elseif(NOT DEFINED FLUTTER_TARGET_PLATFORM AND
         CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(${output} "linux-arm64" PARENT_SCOPE)
  else()
    set(${output} "linux" PARENT_SCOPE)
  endif()
endfunction()

function(thermion_filament_headers output package_root platform)
  set(_version_file "${package_root}/lib/filament_version.dart")
  if(NOT EXISTS "${_version_file}")
    message(FATAL_ERROR "thermion_flutter: missing Filament version: ${_version_file}")
  endif()
  file(READ "${_version_file}" _version_source)
  string(REGEX MATCH "filamentVersion[ \t\r\n]*=[ \t\r\n]*'([^']+)'" _match "${_version_source}")
  if(NOT _match)
    message(FATAL_ERROR "thermion_flutter: cannot read Filament version from ${_version_file}")
  endif()
  set(_version "${CMAKE_MATCH_1}")

  set(_pin_file "${package_root}/filament.libs.json")
  set(_pin "{}")
  if(EXISTS "${_pin_file}")
    file(READ "${_pin_file}" _contents)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_contents}")
    if(NOT _error AND _type STREQUAL "OBJECT")
      set(_pin "${_contents}")
    else()
      message(WARNING "thermion_flutter: invalid ${_pin_file}; using legacy artifact paths")
    endif()
  endif()
  thermion_escape_for_generator(_version_file_dep "${_version_file}")
  thermion_escape_for_generator(_pin_file_dep "${_pin_file}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_version_file_dep}" "${_pin_file_dep}")

  # The hook defaults to release even for a Flutter Debug build. Headers are
  # mode-independent, so include both resolved paths and let the hook populate
  # its selected mode. Do not require either directory to exist at configure.
  set(_headers "")
  foreach(_mode IN ITEMS release debug)
    set(_suffix "")
    string(JSON _type ERROR_VARIABLE _error TYPE "${_pin}" "${platform}/${_mode}")
    if(NOT _error)
      string(JSON _sha GET "${_pin}" "${platform}/${_mode}")
      string(LENGTH "${_sha}" _length)
      if(_type STREQUAL "STRING" AND _length EQUAL 64 AND _sha MATCHES "^[0-9a-fA-F]+$")
        string(TOLOWER "${_sha}" _sha)
        string(SUBSTRING "${_sha}" 0 16 _hash)
        set(_suffix "-${_hash}")
      else()
        message(WARNING "thermion_flutter: invalid ${platform}/${_mode} pin; using legacy artifact path")
      endif()
    endif()
    if(platform STREQUAL "linux-arm64")
      list(APPEND _headers
        "${package_root}/.dart_tool/thermion_dart/lib/${_version}/linux/${_mode}/arm64${_suffix}/include")
    else()
      list(APPEND _headers
        "${package_root}/.dart_tool/thermion_dart/lib/${_version}/${platform}/${_mode}${_suffix}/include")
    endif()
  endforeach()
  set(${output} "${_headers}" PARENT_SCOPE)
endfunction()

# Resolves existing ancestor symlinks while preserving any not-yet-created leaf
# suffix so expected future paths compare equal across symlinked roots.
function(_thermion_canonical_key output path)
  get_filename_component(_cur "${path}" ABSOLUTE)
  if(NOT _cur STREQUAL "/" AND NOT _cur MATCHES "^[A-Za-z]:/$")
    string(REGEX REPLACE "/+$" "" _cur "${_cur}")
  endif()
  set(_suffix "")
  while(NOT EXISTS "${_cur}")
    get_filename_component(_name "${_cur}" NAME)
    get_filename_component(_parent "${_cur}" DIRECTORY)
    if(_parent STREQUAL "${_cur}" OR "${_parent}" STREQUAL "")
      break()
    endif()
    if(_suffix STREQUAL "")
      set(_suffix "${_name}")
    else()
      set(_suffix "${_name}/${_suffix}")
    endif()
    set(_cur "${_parent}")
  endwhile()
  if(EXISTS "${_cur}")
    get_filename_component(_cur "${_cur}" REALPATH)
    if(NOT _cur STREQUAL "/" AND NOT _cur MATCHES "^[A-Za-z]:/$")
      string(REGEX REPLACE "/+$" "" _cur "${_cur}")
    endif()
  endif()
  if(NOT _suffix STREQUAL "")
    if(_cur STREQUAL "/" OR _cur MATCHES "^[A-Za-z]:/$")
      set(_cur "${_cur}${_suffix}")
    else()
      set(_cur "${_cur}/${_suffix}")
    endif()
  endif()
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${_cur}" _cur)
  endif()
  set(${output} "${_cur}" PARENT_SCOPE)
endfunction()

# MSBuild (Visual Studio generator) unescapes %XX sequences in project XML
# metadata, so a literal '%' in an include dir or custom-build dependency
# (e.g. a pub-cache path containing 'dir%20lit') is corrupted to 'dir lit'
# unless it is written as '%25'. CMake's own file()/EXISTS checks must keep
# the unescaped path, so apply this only where paths are handed to the
# generator: target_include_directories and CMAKE_CONFIGURE_DEPENDS.
# No-op for Ninja/Makefile generators and POSIX hosts.
function(thermion_escape_for_generator output path)
  if(CMAKE_GENERATOR MATCHES "Visual Studio" AND path MATCHES "%")
    string(REPLACE "%" "%25" _escaped "${path}")
    set(${output} "${_escaped}" PARENT_SCOPE)
  else()
    set(${output} "${path}" PARENT_SCOPE)
  endif()
endfunction()

# Filters DART_PKG_HEADERS from generated_headers.cmake:
# - Entries matching expected_headers are already supplied deterministically
#   (and may not exist yet after a partial .dart_tool clean), so drop silently.
# - Other non-existent entries come from stale hook output and emit a warning.
function(thermion_filter_generated_headers headers_var expected_headers)
  if(NOT ${headers_var})
    return()
  endif()

  set(_expected_keys "")
  foreach(_exp IN LISTS expected_headers)
    _thermion_canonical_key(_exp_key "${_exp}")
    list(APPEND _expected_keys "${_exp_key}")
  endforeach()

  set(_filtered "")
  foreach(_dir IN LISTS ${headers_var})
    _thermion_canonical_key(_dir_key "${_dir}")
    list(FIND _expected_keys "${_dir_key}" _in_expected)
    if(NOT IS_DIRECTORY "${_dir}")
      if(_in_expected EQUAL -1)
        message(WARNING
          "thermion_flutter: ignoring non-existent include dir from "
          "generated_headers.cmake (stale hook output?): ${_dir}")
      endif()
    elseif(_in_expected EQUAL -1)
      list(APPEND _filtered "${_dir}")
    endif()
  endforeach()
  set(${headers_var} "${_filtered}" PARENT_SCOPE)
endfunction()
