# NOTE: pub uses .pubignore *instead of* .gitignore when present, so the
# .gitignore rules below must be mirrored here.
**/*.log
examples/
examples/assets/
**/build*/
**/assets/
**/test/
**/*.dylib
**/*.o

# Mirror of .gitignore (excluding **/*.g.dart so generated bindings ship):
build/
native/build/
native/web/lib/**/*
pubspec.lock
test/output/*
test/generated/libThermionTextureSwift.dylib

# Re-include generated bindings — the repo-root .gitignore excludes **/*.g.dart,
# but consumers need these checked-in generated files.
!lib/src/swift/swift_bindings.g.dart

# Web build output (also gets created locally outside .gitignore patterns)
native/web/build-debug/
native/test/thermion_dart.js
native/test/thermion_dart.wasm

# Test assets are a symlink to ../../examples/assets (~68 MB) — never ship.
test/assets/

# Built/downloaded test artifacts
test/golden-downloads/
test/thermion_dart.js
test/thermion_dart.wasm
test/*.html

# Scratch / debug
output.png
*.patch

# Internal-only docs
BONE_VISUALIZATION.md
BONE_VISUALIZATION_IMPROVEMENTS.md
RM_BONES.md

# IDE metadata
*.iml

# Developer-local path overrides — committed for the team but must NOT ship
# (published packages can't reference local paths).
pubspec_overrides.yaml
